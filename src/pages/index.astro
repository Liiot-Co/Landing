---
import Layout from "@/components/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import StoryPath from "@/components/StoryPath.astro";
import Hero from "@/components/Hero.astro";
import Villain from "@/components/Villain.astro";
import Philosophy from "@/components/Philosophy.astro";
import HowWeWork from "@/components/HowWeWork.astro";
import Portfolio from "@/components/Portfolio.astro";
import Team from "@/components/Team.astro";
import FinalCTA from "@/components/FinalCTA.astro";
import Footer from "@/components/Footer.astro";
---

<Layout>
  <Navbar />
  <main class="relative bg-background">
    <StoryPath />
    <Hero />
    <Villain />
    <Philosophy />
    <HowWeWork />
    <Portfolio />
    <Team />
    <FinalCTA />
  </main>
  <Footer />
</Layout>
