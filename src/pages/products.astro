---
import Layout from "@/components/layouts/Layout.astro";
import Navigation from "@/components/Navigation.astro";
import Footer from "@/components/Footer.astro";
import { 
  Calendar, 
  Clock, 
  Users, 
  Zap, 
  Shield, 
  BarChart3, 
  CheckCircle2, 
  Layers,
  Sparkles
} from 'lucide-astro';
import Button from "@/components/ui/button.astro";
import FinalCTAButton from "@/components/FinalCTAButton.astro";

const GALLERY_ID = "features-grid";
const HEADER_ID = "products-header";
---

<Layout>
  <Navigation />
  
  <main class="min-h-screen pt-24 pb-20 relative overflow-hidden">
    
    {/* Decorative Background Elements */}
    <div class="fixed inset-0 pointer-events-none z-0">
        <div class="absolute top-[-10%] right-[-5%] w-[500px] h-[500px] bg-primary/10 blur-[100px] rounded-full mix-blend-multiply dark:mix-blend-screen animate-pulse duration-[5000ms]"></div>
        <div 
          class="absolute bottom-[10%] left-[-10%] w-[600px] h-[600px] blur-[120px] rounded-full mix-blend-multiply dark:mix-blend-screen"
          style="background-color: oklch(from var(--accent) l c h / 0.05);"
        ></div>
    </div>

    {/* Hero Section */}
    <section class="container mx-auto px-4 relative z-10 mb-20">
      <div id={HEADER_ID} class="max-w-4xl mx-auto text-center opacity-0 translate-y-4">
        
        {/* Badge */}
        <div 
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-semibold mb-8 backdrop-blur-sm"
          style="background-color: oklch(from var(--accent) l c h / 0.1); border: 1px solid oklch(from var(--accent) l c h / 0.2); color: var(--accent-foreground);"
        >
          <Sparkles class="w-4 h-4" style="color: var(--accent);" /> 
          <span>Plataforma v2.0 Disponible</span>
        </div>

        <h1 class="text-5xl lg:text-7xl font-bold mb-6 tracking-tight leading-[1.1]">
          Centraliza tus operaciones con <span class="text-gradient">precisión absoluta</span>
        </h1>
        
        <p class="text-xl text-muted-foreground mb-10 max-w-2xl mx-auto leading-relaxed">
          Diseñado para equipos que buscan claridad. Sincroniza calendarios, rastrea tiempo y gestiona recursos en una interfaz unificada y segura.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <FinalCTAButton size="compact" showArrow={false}>
              Comenzar Prueba Gratis
            </FinalCTAButton>
            <Button 
              variant="outline" 
              size="lg" 
              class="bg-background/50 backdrop-blur-sm border-input px-8 h-12 rounded-lg text-lg"
              style="--hover-bg: oklch(from var(--primary) l c h / 0.05);"
            >
              Agendar Demo
            </Button>
        </div>
      </div>
    </section>

    {/* Bento Grid Feature Section */}
    <section id={GALLERY_ID} class="container mx-auto px-4 relative z-10">
      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
        
        {/* CARD 1: Calendar (Wide - Spans 2 cols) */}
        <div class="col-span-1 md:col-span-2 lg:col-span-2 row-span-2 group gallery-item opacity-0 translate-y-4">
          <div class="h-full bg-card border border-border rounded-2xl p-8 flex flex-col hover:border-primary/50 transition-all-smooth relative overflow-hidden shadow-sm hover:shadow-md">
            <div class="relative z-10">
              <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center mb-6">
                <Calendar class="w-6 h-6 text-primary" />
              </div>
              <h3 class="text-2xl font-bold mb-2">Smart Scheduling</h3>
              <p class="text-muted-foreground mb-6 max-w-md">
                Algoritmos que encuentran huecos óptimos para "Deep Work" automáticamente.
              </p>
            </div>
            
            {/* CSS-Only Calendar Mockup */}
            <div class="mt-auto relative w-full h-64 bg-background border border-border rounded-xl p-4 shadow-inner overflow-hidden flex flex-col gap-2">
                <div class="flex justify-between items-center border-b border-border pb-2 mb-2">
                    <div class="h-2 w-20 bg-muted-foreground/20 rounded"></div>
                    <div class="flex gap-1">
                        <div class="h-2 w-6 bg-muted-foreground/20 rounded"></div>
                        <div class="h-2 w-6 bg-muted-foreground/20 rounded"></div>
                    </div>
                </div>
                {/* Event Blocks */}
                <div class="grid grid-cols-4 gap-2 h-full relative">
                    <div class="absolute left-0 top-0 bottom-0 w-[1px] bg-border z-0"></div>
                    
                    {/* Event 1 */}
                    <div class="col-start-1 col-span-2 bg-primary/10 border-l-4 border-primary rounded p-2 mt-4 h-20 animate-in fade-in slide-in-from-bottom-2 duration-700">
                        <div class="h-2 w-16 bg-primary/40 rounded mb-2"></div>
                        <div class="h-1.5 w-10 bg-primary/30 rounded"></div>
                    </div>
                    {/* Event 2 */}
                    <div 
                      class="col-start-3 col-span-2 rounded p-2 mt-12 h-24 animate-in fade-in slide-in-from-bottom-2 duration-1000 delay-100"
                      style="background-color: oklch(from var(--accent) l c h / 0.1); border-left: 4px solid var(--accent);"
                    >
                        <div class="h-2 w-20 rounded mb-2" style="background-color: oklch(from var(--accent) l c h / 0.4);"></div>
                        <div class="h-1.5 w-12 rounded" style="background-color: oklch(from var(--accent) l c h / 0.3);"></div>
                    </div>
                </div>
            </div>
          </div>
        </div>

        {/* CARD 2: Analytics (Tall - Spans 1 col) */}
        <div class="col-span-1 md:col-span-1 lg:col-span-1 row-span-2 group gallery-item opacity-0 translate-y-4">
          <div class="h-full bg-card border border-border rounded-2xl p-6 hover:border-primary/50 transition-all-smooth flex flex-col">
            <div class="mb-auto">
                <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center mb-4">
                    <BarChart3 class="w-5 h-5 text-accent" />
                </div>
                <h3 class="text-xl font-bold mb-2">Métricas Reales</h3>
                <p class="text-sm text-muted-foreground">ROI y eficiencia por proyecto en tiempo real.</p>
            </div>
            
            {/* CSS Chart Mockup */}
            <div class="mt-8 flex items-end justify-between gap-2 h-40 px-2 pb-2 border-b border-border">
                <div class="w-full bg-primary/20 rounded-t-sm h-[40%] group-hover:h-[60%] transition-all duration-500 relative"></div>
                <div class="w-full bg-primary/40 rounded-t-sm h-[70%] group-hover:h-[50%] transition-all duration-500 delay-75"></div>
                <div class="w-full bg-accent/60 rounded-t-sm h-[50%] group-hover:h-[85%] transition-all duration-500 delay-100 relative shadow-[0_0_15px_rgba(var(--accent),0.5)]">
                    <div class="absolute -top-6 left-1/2 -translate-x-1/2 text-[10px] font-bold text-accent bg-accent/10 px-1 rounded opacity-0 group-hover:opacity-100 transition-opacity">
                        +24%
                    </div>
                </div>
                <div class="w-full bg-primary/30 rounded-t-sm h-[60%] group-hover:h-[55%] transition-all duration-500 delay-150"></div>
            </div>
          </div>
        </div>

        {/* CARD 3: Team Sync (Tall - Spans 1 col) */}
        <div class="col-span-1 md:col-span-3 lg:col-span-1 row-span-2 group gallery-item opacity-0 translate-y-4">
            <div class="h-full bg-card border border-border rounded-2xl p-6 hover:border-primary/50 transition-all-smooth flex flex-col">
                <div class="mb-auto">
                    <div class="w-10 h-10 rounded-lg bg-secondary flex items-center justify-center mb-4">
                        <Users class="w-5 h-5 text-foreground" />
                    </div>
                    <h3 class="text-xl font-bold mb-2">Team Sync</h3>
                    <p class="text-sm text-muted-foreground">Colaboración fluida con estados automáticos.</p>
                </div>

                {/* Team List Mockup */}
                <div class="mt-8 space-y-4">
                    {[1, 2, 3].map((_, i) => (
                        <div class="flex items-center gap-3 p-3 rounded-xl bg-muted/40 border border-transparent group-hover:border-border/50 transition-colors">
                            <div class={`w-8 h-8 rounded-full ${i === 0 ? 'bg-primary/20' : i === 1 ? 'bg-accent/20' : 'bg-muted-foreground/20'}`}></div>
                            <div class="flex-1 space-y-1.5">
                                <div class="w-16 h-1.5 bg-foreground/20 rounded-full"></div>
                                <div class="w-10 h-1.5 bg-foreground/10 rounded-full"></div>
                            </div>
                            <div class={`w-2 h-2 rounded-full ${i === 0 ? 'bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.4)]' : i === 1 ? 'bg-purple-500' : 'bg-zinc-400'}`}></div>
                        </div>
                    ))}
                </div>
            </div>
        </div>

      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
	import { animate, inView, stagger } from "motion";

	const HEADER_ID = "#products-header";
	const GALLERY_ID = "#features-grid";
	const GALLERY_ITEMS = ".gallery-item";

	// Header Animation
	inView(HEADER_ID, () => {
		animate(HEADER_ID, { opacity: 1, y: [20, 0] }, { duration: 0.7, easing: "ease-out" });
	});

	// Grid Animation
	inView(GALLERY_ID, () => {
		const items = document.querySelectorAll(GALLERY_ITEMS);
		animate(items, { opacity: 1, y: [30, 0] }, {
			delay: stagger(0.1),
			duration: 0.6,
			easing: "ease-out"
		});
	}, { margin: "-50px" });
</script>

<style>
    .gallery-item {
        will-change: transform, opacity;
    }
</style>