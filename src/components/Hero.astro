---
/**
 * Hero — abre con el llamado a la aventura del visitante (viaje del héroe,
 * etapa 1: "El Héroe"), no con la marca. Imagen a pantalla completa, con
 * aire suficiente para leer y solo una viñeta local detrás del texto.
 *
 * Interacciones:
 * - Palabras interactivas: click para alternar palabras con animación Josh W. Comeau Squash and Stretch.
 * - UX de edición viva: cursor parpadeante (blink caret) en lugar de botones o bordes dashed.
 * - Transformación ultra-suave del font-weight con Satoshi Variable (550 -> 900).
 */
import MorphGradient from "@/components/ui/MorphGradient.astro";
import SectionFade from "@/components/ui/SectionFade.astro";
import { LIIOT_CALENDLY_URL } from "@/constants/contact";
import { HERO_IMAGE, HERO_IMAGE_WIDTHS, HERO_IMAGE_FALLBACK, HERO_FOCUS } from "@/constants/hero";
import { unsplashResize, unsplashSrcSet } from "@/lib/images";
import { t } from "@/i18n";
---

<section
  id="hero"
  class="relative flex h-svh min-h-[580px] sm:h-screen sm:min-h-[680px] items-end overflow-hidden bg-background"
>
  {/* Fondo — la foto se ve completa; con skeleton shimmer loader y LQIP para LCP óptimo */}
  <div
    id="hero-bg"
    class="absolute inset-0 bg-[#07040F] overflow-hidden"
    style={`--hero-focus-mobile:${HERO_FOCUS.mobile};--hero-focus-desktop:${HERO_FOCUS.desktop}`}
  >
    {/* Skeleton / Shimmer loader de alta velocidad mientras descarga la foto */}
    <div
      id="hero-image-skeleton"
      class="hero-skeleton absolute inset-0 transition-opacity duration-700 pointer-events-none"
      aria-hidden="true"
    ></div>

    {/* Imagen en ultra-baja resolución (LQIP) para First Meaningful Paint instantáneo */}
    <img
      src={unsplashResize(HERO_IMAGE, 64, 25)}
      alt=""
      aria-hidden="true"
      class="hero-focus-img absolute inset-0 h-full w-full object-cover filter blur-xl scale-110 pointer-events-none opacity-60"
    />

    {/* Imagen LCP principal de alta resolución con carga progresiva y revelado suave */}
    <img
      id="hero-main-img"
      src={unsplashResize(HERO_IMAGE, 1536, 65)}
      srcset={unsplashSrcSet(HERO_IMAGE, HERO_IMAGE_WIDTHS, 65)}
      sizes="100vw"
      alt={t.hero.imageAlt}
      class="hero-bg-img hero-focus-img absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700 ease-out"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
      onload="this.classList.remove('opacity-0'); this.classList.add('opacity-100'); document.getElementById('hero-image-skeleton')?.classList.add('opacity-0');"
      onerror={`this.src='${HERO_IMAGE_FALLBACK}'; this.classList.remove('opacity-0');`}
    />

    {/* Radial gradient: matices vibrantes sutiles integrados con el diseño */}
    <div
      class="hero-radial-gradient absolute inset-0 pointer-events-none"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-x-0 bottom-0 h-[50%] bg-gradient-to-t from-background via-background/25 to-transparent pointer-events-none"
      aria-hidden="true"
    >
    </div>
    <MorphGradient recipe="hybrid" blend="soft-light" opacity={0.20} />
  </div>

  <div class="container relative z-10 mx-auto px-4 pb-12 sm:px-6 sm:pb-20 lg:px-8 lg:pb-28">
    {/* Titular interactivo con tipografía cinética suave y líneas estables anti-shift */}
    <h1
      id="hero-title"
      class="headline-editorial hero-kinetic-title max-w-5xl text-[clamp(2.1rem,9.6vw,6.4rem)] leading-[0.98] text-foreground sm:text-[clamp(3.2rem,8.2vw,6.5rem)] lg:text-[clamp(4rem,6.8vw,6.8rem)]"
      data-keywords={JSON.stringify(t.hero.keywords)}
      data-prefixes={JSON.stringify(t.hero.prefixes)}
      data-suffixes={JSON.stringify(t.hero.suffixes)}
    >
      <span class="title-line block whitespace-nowrap">
        <button
          type="button"
          id="swap-prefix"
          class="kinetic-word-btn inline-block text-left"
          aria-label={t.hero.aria.toggleAction}
          title={t.hero.aria.toggleActionTitle}
        >
          <span id="prefix-text" class="kinetic-word">{t.hero.prefixes[0]}</span>
        </button>{" "}
        <span class="kinetic-word">{t.hero.connector}</span>
      </span>
      <span class="title-line block whitespace-nowrap">
        <button
          type="button"
          id="hero-swap-btn"
          class="interactive-word-btn inline-block text-left"
          aria-label={t.hero.aria.toggleKeyword}
          title={t.hero.aria.toggleKeywordTitle}
        >
          <span
            id="hero-swap-word"
            class="kinetic-word active-keyword inline-block"
          >
            {t.hero.keywords[0]?.text ?? "futuro"}
          </span>
        </button>{" "}
        <button
          type="button"
          id="swap-suffix"
          class="kinetic-word-btn inline-block text-left"
          aria-label={t.hero.aria.toggleSuffix}
          title={t.hero.aria.toggleSuffixTitle}
        >
          <span id="suffix-text" class="kinetic-word">{t.hero.suffixes[0]}</span>
        </button>
      </span>
    </h1>

    <p
      id="hero-body"
      class="mt-9 max-w-md text-sm font-medium leading-relaxed text-muted-foreground sm:text-base"
    >
      {t.hero.body}
    </p>

    <div id="hero-cta" class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-5">
      <a
        href={LIIOT_CALENDLY_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-editorial btn-editorial--violet inline-flex items-center justify-center px-8 py-4 text-sm uppercase tracking-[0.1em]"
      >
       {t.hero.mainCTA}
      </a>
      <a
        href="#el-reto"
        class="text-sm font-bold uppercase tracking-[0.1em] text-foreground underline decoration-accent decoration-2 underline-offset-4 transition-opacity hover:opacity-70"
      >
        {t.hero.secondCTA}
      </a>
    </div>
  </div>

  {/* Script inmediato para revelar imagen si ya está en caché del navegador (0ms LCP) */}
  <script is:inline>
    (function () {
      const img = document.getElementById("hero-main-img");
      if (img && img.complete) {
        img.classList.remove("opacity-0");
        img.classList.add("opacity-100");
        const sk = document.getElementById("hero-image-skeleton");
        if (sk) sk.classList.add("opacity-0");
      }
    })();
  </script>

  {/* Fade suave hacia la siguiente sección */}
  <SectionFade position="bottom" color="background" height="h-28 sm:h-44" zIndex="z-[6]" />
</section>

<style>
  .hero-skeleton {
    background: rgba(15, 9, 28, 0.95);
    overflow: hidden;
  }

  /* Barrido de carga en pseudo-elemento con transform (compuesto por GPU):
     `background-position` animado forzaba repaint por frame y Lighthouse lo
     marca como animación no compuesta. Mismo visual, cero repaint. */
  .hero-skeleton::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(42, 22, 68, 0.45) 50%,
      transparent 100%
    );
    transform: translateX(-100%);
    /* Single pass only — the skeleton is hidden by the image's opacity
       fade-in well before a loop would matter, so looping it forever just
       burns frames in the background. */
    animation: heroShimmer 2.2s ease-in-out 1;
  }

  @keyframes heroShimmer {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  /* Perpetual fullscreen zoom removed — the hero image now relies solely on
     its one-time opacity fade-in (see `.hero-bg-img` utility classes above)
     instead of an infinite GPU-composited scale animation. */

  /* Punto focal de la foto: en celular el recorte vertical muestra solo una franja,
     así que `--hero-focus-mobile` decide qué parte de la foto queda a la vista. */
  .hero-focus-img {
    object-position: var(--hero-focus-mobile, 50% 30%);
  }

  @media (min-width: 768px) {
    .hero-focus-img {
      object-position: var(--hero-focus-desktop, 50% 40%);
    }
  }

  /* Gradiente radial integrado con elegancia: matices vibrantes sutiles y armónicos */
  .hero-radial-gradient {
    background:
      /* Toque sutil de calidez y creatividad en el cuadrante superior derecho */
      radial-gradient(
        ellipse 70% 60% at 80% 20%,
        rgba(224, 75, 102, 0.18) 0%,
        rgba(255, 106, 51, 0.13) 35%,
        rgba(226, 179, 28, 0.07) 60%,
        transparent 80%
      ),
      /* Matiz violeta suave de identidad tecnológica en el centro superior */
      radial-gradient(
        ellipse 60% 50% at 35% 25%,
        rgba(139, 69, 204, 0.18) 0%,
        rgba(90, 34, 139, 0.10) 45%,
        transparent 75%
      ),
      /* Viñeta sutil de anclaje oscuro para máxima legibilidad del texto en la esquina inferior izquierda */
      radial-gradient(
        ellipse 85% 65% at 15% 95%,
        rgba(7, 4, 15, 0.82) 0%,
        rgba(15, 9, 28, 0.42) 45%,
        transparent 75%
      );
  }

  /* ════════════════════════════════════════════════════════════════════
     TIPOGRAFÍA CINÉTICA ULTRA-SMOOTH (WEIGHT 550 -> 900)
     ════════════════════════════════════════════════════════════════════ */
  .hero-kinetic-title {
    user-select: none;
    line-height: 0.98;
  }

  .title-line {
    display: block;
    white-space: nowrap;
    overflow: visible;
  }

  .kinetic-word-btn,
  .interactive-word-btn {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    vertical-align: baseline;
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }

  .interactive-word-btn {
    position: relative;
    transform-origin: bottom center;
  }

  .kinetic-word {
    display: inline-block;
    font-weight: 700;
    transform-origin: bottom center;
    transition:
      font-weight 380ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 300ms ease,
      transform 300ms cubic-bezier(0.16, 1, 0.3, 1),
      color 300ms ease;
    cursor: pointer;
  }

  /* Al pasar el cursor por el titular: las palabras no enfocadas se suavizan a 550 sin colapso */
  .hero-kinetic-title:hover .kinetic-word {
    font-weight: 550;
    opacity: 0.85;
  }

  /* La palabra sobre la que está el cursor se expande a 900 con suavidad líquida */
  .hero-kinetic-title .kinetic-word:hover,
  .hero-kinetic-title .kinetic-word-btn:hover .kinetic-word,
  .hero-kinetic-title .interactive-word-btn:hover .kinetic-word {
    font-weight: 900 !important;
    opacity: 1 !important;
    transform: translateY(-2px);
  }

  /* ════════════════════════════════════════════════════════════════════
     PALABRA CLAVE: SIN DASHED, COLOR VIVO Y BLINK CURSOR
     ════════════════════════════════════════════════════════════════════ */
  .active-keyword {
    color: var(--accent);
    border: none !important;
    padding: 0;
    transform-origin: bottom center;
  }



  /* ════════════════════════════════════════════════════════════════════
     JOSH W. COMEAU: SQUASH AND STRETCH ANIMATION (CRISP & SHARP)
     ════════════════════════════════════════════════════════════════════ */
  /* Mousedown / Active: Squash de anticipación (se aplasta y ensancha contra el suelo) */
  .interactive-word-btn:active .active-keyword,
  .kinetic-word-btn:active .kinetic-word {
    transform: scale(1.14, 0.86) translateY(3px) !important;
    transition: transform 70ms ease-out !important;
  }

  /* Clase Squash & Stretch al alternar palabra: 100% nítida, sin blur ni pérdidas de opacidad */
  .is-squashing-and-stretching {
    animation: jwc-squash-and-stretch 400ms cubic-bezier(0.25, 1, 0.5, 1) forwards;
    backface-visibility: hidden;
    -webkit-font-smoothing: antialiased;
    transform-origin: bottom center;
    opacity: 1 !important;
  }

  @keyframes jwc-squash-and-stretch {
    0% {
      /* Anticipación / compresión elástica */
      transform: scale(1.14, 0.86) translateY(3px);
    }
    30% {
      /* STRETCH: rebota hacia arriba estirándose de forma nítida */
      transform: scale(0.88, 1.14) translateY(-8px);
    }
    60% {
      /* SQUASH DE IMPACTO: aterriza con compresión elástica */
      transform: scale(1.06, 0.94) translateY(2px);
    }
    82% {
      /* OVERSHOOT de micro-ajuste */
      transform: scale(0.98, 1.02) translateY(-1px);
    }
    100% {
      /* REPOSO PERFECTO */
      transform: scale(1, 1) translateY(0);
    }
  }

  /* Prefers reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .is-squashing-and-stretching,
    .hero-bg-img {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  let autoRotateTimer: number | null = null;

  function stopHeroAutoRotation() {
    if (autoRotateTimer !== null) {
      clearInterval(autoRotateTimer);
      autoRotateTimer = null;
    }
  }

  function initHeroWordInteraction() {
    stopHeroAutoRotation();

    const swapBtn = document.getElementById("hero-swap-btn");
    const swapWord = document.getElementById("hero-swap-word");
    const prefixBtn = document.getElementById("swap-prefix");
    const prefixText = document.getElementById("prefix-text");
    const suffixBtn = document.getElementById("swap-suffix");
    const suffixText = document.getElementById("suffix-text");
    const heroTitle = document.getElementById("hero-title");

    let keywords: Array<{ text: string; color: string }> = [];
    try {
      keywords = heroTitle?.dataset.keywords ? JSON.parse(heroTitle.dataset.keywords) : [];
    } catch {}
    if (!keywords.length) {
      keywords = [
        { text: "futuro", color: "var(--accent)" },
        { text: "negocio", color: "var(--primary-high)" },
        { text: "equipo", color: "var(--brand-pink)" },
        { text: "gente", color: "var(--brand-yellow)" },
        { text: "confianza", color: "var(--accent)" },
        { text: "propósito", color: "var(--brand-pink)" },
      ];
    }

    let prefixes: string[] = [];
    try {
      prefixes = heroTitle?.dataset.prefixes ? JSON.parse(heroTitle.dataset.prefixes) : [];
    } catch {}
    if (!prefixes.length) prefixes = ["Construimos", "Diseñamos", "Creamos", "Impulsamos"];

    let suffixes: string[] = [];
    try {
      suffixes = heroTitle?.dataset.suffixes ? JSON.parse(heroTitle.dataset.suffixes) : [];
    } catch {}
    if (!suffixes.length) suffixes = ["contigo", "a tu lado", "en equipo", "de verdad"];

    let kwIdx = 0;
    let preIdx = 0;
    let sufIdx = 0;
    let isKwAnimating = false;
    let isHovering = false;

    function triggerSquashStretch(el: HTMLElement | null, updateFn: () => void) {
      if (!el) return;
      // Actualizar el texto inmediatamente de forma nítida sin desfase visual
      updateFn();

      el.classList.remove("is-squashing-and-stretching");
      void el.offsetWidth; // Force reflow
      el.classList.add("is-squashing-and-stretching");

      setTimeout(() => {
        el.classList.remove("is-squashing-and-stretching");
      }, 400);
    }

    function advanceKeyword() {
      if (isKwAnimating) return;
      isKwAnimating = true;

      kwIdx = (kwIdx + 1) % keywords.length;
      const next = keywords[kwIdx];

      triggerSquashStretch(swapWord, () => {
        if (swapWord) {
          swapWord.textContent = next.text;
          swapWord.style.color = next.color;
        }
      });

      setTimeout(() => {
        isKwAnimating = false;
      }, 400);
    }

    function startAutoRotation() {
      stopHeroAutoRotation();
      autoRotateTimer = window.setInterval(() => {
        if (document.hidden || isHovering) return;
        advanceKeyword();
      }, 3000);
    }

    swapBtn?.addEventListener("click", () => {
      advanceKeyword();
      startAutoRotation(); // Reiniciar ciclo tras interacción manual
    });

    prefixBtn?.addEventListener("click", () => {
      preIdx = (preIdx + 1) % prefixes.length;
      triggerSquashStretch(prefixText, () => {
        if (prefixText) prefixText.textContent = prefixes[preIdx];
      });
      startAutoRotation();
    });

    suffixBtn?.addEventListener("click", () => {
      sufIdx = (sufIdx + 1) % suffixes.length;
      triggerSquashStretch(suffixText, () => {
        if (suffixText) suffixText.textContent = suffixes[sufIdx];
      });
      startAutoRotation();
    });

    // Pausar en hover para no interrumpir la lectura del usuario
    heroTitle?.addEventListener("mouseenter", () => {
      isHovering = true;
    });

    heroTitle?.addEventListener("mouseleave", () => {
      isHovering = false;
      startAutoRotation();
    });

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        stopHeroAutoRotation();
      } else {
        startAutoRotation();
      }
    });

    // Iniciar rotación automática cada 3 segundos
    startAutoRotation();
  }

  if (document.readyState === "complete" || document.readyState === "interactive") {
    initHeroWordInteraction();
  } else {
    document.addEventListener("DOMContentLoaded", initHeroWordInteraction);
  }
  document.addEventListener("astro:page-load", initHeroWordInteraction);
  document.addEventListener("astro:before-swap", stopHeroAutoRotation);
</script>
