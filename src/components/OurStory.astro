---
/**
 * "El Villano → Nuestra filosofía" — wipe cinematográfico (viaje del héroe,
 * etapas 2-3), maquetado como una doble página de revista: kicker + folio de
 * página, tipografía editorial grande y un collage fotográfico interactivo
 * en vez de un simple bloque de texto sobre un fondo animado.
 *
 * EL RETO (01, frío, violeta) — notas tachadas como recortes de prensa
 * (`obstacles`) + una foto desaturada de un escritorio genérico ("así no").
 * LA FILOSOFÍA (02, cálida, vívida) responde `obstacles` uno a uno con
 * `resolutions`, mismo número (01↔01, 02↔02, 03↔03) — la relación "esto
 * combatimos → así lo resolvemos" queda explícita por el emparejamiento, no
 * solo implícita en el tono. La filosofía lleva además dos fotos
 * superpuestas del equipo real trabajando, con un sticker de caption, como
 * una página de "quiénes somos" de revista. Las fotos crecen un poco al
 * hover (misma curva `--dt-easing-human` que ya usan las cards de
 * HowWeWork.astro) — el collage responde, no es estático. Sin rotaciones:
 * ni fotos ni texto se inclinan, todo alineado en grilla.
 *
 * El fondo de la filosofía es un mesh gradient: color base sólido +
 * múltiples `radial-gradient()` apiladas en `background-image`, cada una
 * anclada en un punto distinto y apagándose a transparent al 50% (sin
 * blur). Usa las posiciones de la receta `hybrid` de `design-tokens.json`
 * (→ core.morphGradient.hybrid: "firma narrativa completa, toda la paleta
 * a partes iguales — máxima libertad artística", reservada para "hero de
 * marketing y portadas narrativas") con los colores de marca. El scrim
 * radial detrás del texto evita que tanto color le quite legibilidad al
 * quote — ya no depende de un divisor decorativo para cerrar la sección.
 *
 * Desktop (≥1024px, motion permitido): `landing-motion.ts` fija la sección
 * en pantalla (`ScrollTrigger` `pin`) y el scroll mueve un corte diagonal
 * (`clip-path: polygon(...)`, variables `--wipe-top`/`--wipe-bottom`) que
 * "abre" la filosofía sobre el reto — el villano nunca se desplaza, es la
 * cortina la que revela lo que hay detrás. Aplica la regla del brandbook
 * "Tech inicia en violeta, Human resuelve en naranja" (§Motion) llevada a su
 * máxima expresión: el wipe ES la narrativa.
 *
 * Mobile / `prefers-reduced-motion`: sin pin ni clip-path — los dos paneles
 * caen a flujo normal, apilados verticalmente (collage debajo del texto),
 * con los mismos reveals en cascada de antes (ver `applyReducedMotionStates`
 * y el bloque `mobileStory` en landing-motion.ts).
 *
 * Copy base: vault §1 "Qué no es Liiot" y vault §3 "Por qué existimos",
 * reescrita con voz narrativa/emocional en segunda persona en vez de
 * fragmentos clínicos.
 */
import { unsplashResize } from "@/lib/images";
import FilosofiaBackground from "@/components/ui/FilosofiaBackground.astro";
import { IMAGES } from "@/constants/images";
import { t } from "@/i18n";

const reto = t.story.reto;
const filosofia = t.story.filosofia;
const obstacles = reto.obstacles;
const resolutions = filosofia.resolutions;
const words = filosofia.quote.split(" ");
---

<section id="el-reto" class="relative bg-background">
  <div id="story-stage" class="story-stage relative">
    {/* PANEL 1 — El reto: la fricción que el visitante ya conoce */}
    <div
      id="story-reto"
      class="story-layer story-layer--reto relative z-[1] flex items-center overflow-hidden bg-background pt-24 pb-14 sm:pt-28 sm:pb-20 lg:py-16 scroll-mt-20"
    >
      <span class="story-folio absolute right-4 top-20 sm:top-24 lg:right-8 lg:top-8" aria-hidden="true">{reto.folio}</span>

      <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:gap-12">
          <div>
            <div id="villain-header" class="max-w-3xl">
              <h2 class="headline-editorial text-4xl text-foreground sm:text-5xl lg:text-6xl">
                {reto.title}<br /><span class="text-brand-pink" data-annotate="el-reto">{reto.highlight}</span>
              </h2>
              {/* Nombra la pelea ANTES de la lista — sin esto, una lista de frases
                  negativas se lee, al escanear, como una descripción de Liiot */}
              <p class="mt-4 text-base font-bold text-muted-foreground sm:text-lg">
                {reto.subtitle}
              </p>
            </div>

            <ul class="mt-8 flex flex-col gap-4 lg:mt-10">
              {
                obstacles.map((o) => (
                  <li class="js-villain-item note-card note-card-reto flex items-baseline gap-3">
                    <span class="text-sm font-bold tabular-nums text-brand-pink/70">{o.n}</span>
                    <p class="text-lg font-bold leading-snug text-foreground/60 line-through decoration-2 decoration-brand-pink/60 sm:text-xl">
                      {o.text}
                    </p>
                  </li>
                ))
              }
            </ul>

            <p
              id="villain-pivot"
              class="mt-10 text-xl font-bold text-muted-foreground sm:text-2xl lg:mt-12"
            >
              {reto.pivot}
            </p>

            {/* PUENTE — pregunta en tono de guía/mentor, no de confesión: evita
                "nosotros" para no sonar a Liiot admitiendo ser el villano. */}
            <p
              id="story-bridge"
              class="mt-4 text-lg font-bold text-accent sm:text-xl"
            >
              {reto.bridge}
            </p>
          </div>

          {/* Collage — una sola foto desaturada: el escritorio genérico de cualquier agencia */}
          <div class="story-collage relative mx-auto mt-4 aspect-[4/5] w-full max-w-[220px] lg:mx-0 lg:mt-0 lg:max-w-none">
            <figure class="story-photo story-photo--cold absolute inset-3 overflow-hidden rounded-2xl">
              <img
                src={unsplashResize(IMAGES.story.reto, 460, 70)}
                alt={reto.imageAlt}
                class="h-full w-full object-cover grayscale"
                loading="lazy"
              />
            </figure>
            <span class="story-tag absolute -right-2 top-8 lg:top-10">{reto.imageTag}</span>
          </div>
        </div>
      </div>
    </div>

    {/* PANEL 2 — La filosofía: Liiot responde como guía, no como protagonista.
        Atmósfera cinematográfica con fondo procedural WebGL2 + GLSL */}
    <div
      id="por-que-existimos"
      class="story-layer story-layer--filosofia relative z-[2] flex items-center overflow-hidden bg-[#08080d] pt-24 pb-14 sm:pt-28 sm:pb-20 lg:py-0 min-h-[100svh] scroll-mt-20"
    >
      <FilosofiaBackground />

      <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <span class="story-folio absolute right-4 top-20 sm:top-24 lg:right-8 lg:top-8" aria-hidden="true">{filosofia.folio}</span>

        <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[52%_48%] lg:gap-14 w-full">
          <div>
            <h2
              id="phil-quote"
              class="headline-editorial text-2xl sm:text-4xl lg:text-5xl xl:text-6xl text-foreground font-bold tracking-tight leading-[1.12] sm:leading-[1.08] max-w-2xl"
            >
              {
                words.map((word) => (
                  <span
                    class="js-phil-word mr-[0.25em] inline-block translate-y-8 scale-95 opacity-0"
                    data-annotate={word === "problema" ? "por-que-existimos" : undefined}
                  >
                    {word}
                  </span>
                ))
              }
            </h2>

            <p class="mt-8 text-base font-bold text-foreground/85 sm:text-lg">
              {filosofia.subtitle}
            </p>

            <ul class="mt-4 flex max-w-xl flex-col gap-3.5">
              {
                resolutions.map((r) => (
                  <li class="group/res flex items-start sm:items-center gap-3.5 rounded-xl p-2 -mx-2 transition-all duration-300 hover:bg-white/[0.04] cursor-default">
                    <span class="inline-flex size-6 flex-shrink-0 items-center justify-center rounded-full bg-white/10 text-xs font-bold tabular-nums text-white group-hover/res:bg-[#FF6A33] group-hover/res:scale-110 transition-all duration-200">
                      {r.n}
                    </span>
                    <p class="text-sm font-medium leading-relaxed text-foreground/80 sm:text-base group-hover/res:text-foreground transition-colors duration-200">
                      {r.text}
                    </p>
                  </li>
                ))
              }
            </ul>
          </div>

          {/* Composición fotográfica: imagen vertical principal + secundaria horizontal abajo a la derecha + CTA */}
          <div class="story-collage relative mx-auto mt-4 aspect-[4/5] w-full max-w-[280px] sm:max-w-[340px] lg:mx-0 lg:mt-0 lg:max-w-none">
            {/* Imagen vertical principal con border-radius grande */}
            <figure class="story-photo story-photo--a absolute left-0 top-0 w-[74%] overflow-hidden rounded-3xl border border-white/10 shadow-2xl">
              <img
                src={unsplashResize(IMAGES.story.filosofiaA, 640, 75)}
                alt={filosofia.imageAlt1}
                class="h-full w-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </figure>
            {/* Segunda imagen horizontal más pequeña superpuesta abajo a la derecha */}
            <figure class="story-photo story-photo--b absolute bottom-2 right-0 w-[60%] overflow-hidden rounded-2xl border border-white/10 shadow-2xl">
              <img
                src={unsplashResize(IMAGES.story.filosofiaB, 560, 75)}
                alt={filosofia.imageAlt2}
                class="h-full w-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </figure>
            {/* Pequeño CTA sobre la imagen */}
            <a
              href="#como-trabajamos"
              class="story-sticker absolute left-2 sm:left-4 bottom-[24%] lg:bottom-[28%] inline-flex items-center gap-1.5 transition-transform duration-200 hover:scale-105 active:scale-95 cursor-pointer"
            >
              {filosofia.stickerCta}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Ensure Safari handles the blur animations smoothly */
  .js-phil-word {
    -webkit-font-smoothing: antialiased;
  }

  /*
   * Estado por defecto (prefers-reduced-motion / antes de que el JS active
   * el modo cine): flujo normal, sin pin ni corte — dos paneles apilados,
   * cada uno legible por sí solo.
   */
  .story-layer {
    min-height: 0;
  }

  /*
   * Modo cine (`landing-motion.ts` añade esta clase en todos los tamaños,
   * salvo `prefers-reduced-motion`, justo antes de crear el ScrollTrigger
   * con pin — así `end: "+=140%"` se calcula sobre el alto real de pantalla,
   * no sobre el alto apilado). Los paneles pasan a superponerse a pantalla
   * completa. `100dvh` evita que la barra de direcciones móvil recorte el
   * pin (con fallback a `100vh` para navegadores sin soporte).
   */
  .story-stage.is-cinematic {
    height: 100vh;
    height: 100dvh;
    height: 100svh;
    overflow: hidden;
  }

  .story-stage.is-cinematic .story-layer {
    position: absolute;
    inset: 0;
    height: 100%;
    padding-top: 0;
    padding-bottom: 0;
  }

  .story-stage.is-cinematic .story-layer--filosofia {
    --wipe-top: 100%;
    --wipe-bottom: 100%;
    clip-path: polygon(
      var(--wipe-top, 100%) 0%,
      100% 0%,
      100% 100%,
      var(--wipe-bottom, 100%) 100%
    );
    will-change: clip-path, transform;
    contain: layout paint;
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
  }

  /*
   * En pantallas angostas, el texto de ambos paneles (encabezado + lista +
   * puente/resoluciones) ya ocupa casi todo el alto disponible del viewport
   * pinneado — el collage fotográfico no cabe sin recortarse. Se oculta solo
   * mientras el modo cine está activo (en flujo normal, sin pin, sigue
   * visible) y el texto pasa a alinearse arriba en vez de centrarse, para
   * que un recorte por overflow afecte el final de la lista, no el titular.
   */
  @media (max-width: 1023.98px) {
    .story-stage.is-cinematic .story-collage {
      display: none;
    }

    .story-stage.is-cinematic .story-layer {
      align-items: flex-start;
      padding-top: max(5.5rem, calc(env(safe-area-inset-top, 0px) + 5.25rem));
      padding-bottom: max(2.5rem, calc(env(safe-area-inset-bottom, 0px) + 2rem));
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .story-stage.is-cinematic,
    .story-stage.is-cinematic .story-layer {
      position: static;
      height: auto;
      clip-path: none;
    }
  }

  /* Filosofía: atmósfera profunda con fondo casi negro */
  .story-layer--filosofia {
    background-color: #08080d;
  }

  /* Folio de página — detalle editorial, como el número de página de una revista */
  .story-folio {
    z-index: 3;
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--muted-foreground);
    opacity: 0.55;
  }

  /* Notas — cada obstáculo se lee como un recorte de prensa, no una fila de lista */
  .note-card {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: color-mix(in oklab, var(--foreground) 3%, transparent);
  }

  /* Collage fotográfico — fotos superpuestas con profundidad de campo interactiva */
  .story-collage {
    isolation: isolate;
    perspective: 1200px;
  }

  .story-photo {
    transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 500ms ease;
    will-change: transform;
  }

  .story-photo--a {
    aspect-ratio: 3 / 4;
    z-index: 1;
  }

  .story-photo--b {
    aspect-ratio: 4 / 3;
    z-index: 2;
  }

  .story-photo--cold {
    aspect-ratio: 3 / 4;
  }

  .story-collage:hover .story-photo--a {
    transform: translateZ(10px) rotate(-1deg) scale(1.02);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
  }

  .story-collage:hover .story-photo--b {
    transform: translateZ(25px) rotate(1.5deg) scale(1.04);
    box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.8);
  }

  .story-collage:hover .story-photo--cold {
    transform: scale(1.02);
  }

  /* Sticker de caption sobre el collage — el detalle "de revista", plano, sin sombra ni borde */
  .story-sticker,
  .story-tag {
    z-index: 3;
    border-radius: 9999px;
    padding: 0.4rem 0.9rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .story-sticker {
    background: var(--accent);
    color: white;
  }

  .story-tag {
    background: var(--card);
    color: var(--muted-foreground);
    text-transform: lowercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .story-photo {
      transition: none;
    }
  }
</style>
