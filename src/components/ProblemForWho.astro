---
import SurfaceCard from "@/components/ui/SurfaceCard.astro";
import SectionAmbience from "@/components/ui/SectionAmbience.astro";
---

<section id="pain-points" class="relative overflow-hidden py-16 lg:py-24">
  <SectionAmbience />

  <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8">
    <div
      id="problem-forwho-header"
      class="mx-auto mb-12 max-w-3xl translate-y-4 text-center opacity-0"
    >
      <p
        class="section-eyebrow mb-3 text-primary font-semibold tracking-wide uppercase text-sm"
      >
        Contexto real
      </p>
      <h2
        class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl lg:text-5xl"
      >
        El problema y <span class="text-gradient">quién lo sufre</span>
      </h2>
      <p
        class="mx-auto mt-4 max-w-2xl text-base font-medium leading-relaxed text-muted-foreground"
      >
        Cuando la operación no puede fallar, una planilla frágil impacta
        cobertura, costos y bienestar.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
      <div class="js-problem-card translate-y-4 opacity-0 lg:col-span-6 flex">
        <SurfaceCard
          class="group/card relative flex w-full flex-col p-1 transition-shadow duration-500 hover:shadow-2xl hover:shadow-destructive/5"
          tone="brand"
        >
          <div
            class="relative flex h-full flex-col overflow-hidden rounded-2xl bg-background/40 p-6 sm:p-8"
          >
            <div
              class="absolute -right-20 -top-20 z-0 h-64 w-64 rounded-full bg-destructive/10 blur-[80px] transition-opacity duration-700 group-hover/card:opacity-60"
            >
            </div>

            <header class="relative z-10 mb-6">
              <h3 class="text-xl font-extrabold text-foreground">
                Tres fugas operativas
              </h3>
              <p class="mt-1 text-sm text-muted-foreground">
                El costo oculto de la gestión manual.
              </p>
            </header>

            <div class="relative z-10 flex flex-col gap-3">
              <div
                class="group/item flex items-start gap-4 rounded-xl border border-white/5 bg-white/5 p-4 transition-all duration-300 hover:bg-white/10 hover:border-white/10"
              >
                <div
                  class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-background shadow-[inset_0_1px_1px_rgba(255,255,255,0.1)] ring-1 ring-white/10 transition-transform duration-300 group-hover/item:scale-110"
                >
                  <svg
                    class="size-5 text-muted-foreground group-hover/item:text-primary transition-colors"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-bold text-foreground">
                    Planificación manual
                  </p>
                  <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                    Decisiones lentas, cruces de datos confusos y errores que se
                    repiten cada mes.
                  </p>
                </div>
              </div>

              <div
                class="group/item flex items-start gap-4 rounded-xl border border-white/5 bg-white/5 p-4 transition-all duration-300 hover:bg-white/10 hover:border-destructive/20"
              >
                <div
                  class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-background shadow-[inset_0_1px_1px_rgba(255,255,255,0.1)] ring-1 ring-white/10 transition-transform duration-300 group-hover/item:scale-110"
                >
                  <div class="relative">
                    <svg
                      class="size-5 text-muted-foreground group-hover/item:text-destructive transition-colors"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                      ></path>
                    </svg>
                    <span
                      class="absolute top-0 right-0 size-2 rounded-full bg-destructive animate-pulse"
                    ></span>
                  </div>
                </div>
                <div>
                  <p class="text-sm font-bold text-foreground">
                    Ausencias sin cobertura
                  </p>
                  <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                    Un turno cae inesperadamente y todo el servicio queda
                    expuesto al instante.
                  </p>
                </div>
              </div>

              <div
                class="group/item flex items-start gap-4 rounded-xl border border-white/5 bg-white/5 p-4 transition-all duration-300 hover:bg-white/10 hover:border-accent/30"
              >
                <div
                  class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-background shadow-[inset_0_1px_1px_rgba(255,255,255,0.1)] ring-1 ring-white/10 transition-transform duration-300 group-hover/item:scale-110"
                >
                  <svg
                    class="size-5 text-muted-foreground group-hover/item:text-accent transition-colors"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-bold text-foreground">
                    Sobrecarga del equipo
                  </p>
                  <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                    Mala distribución que genera más rotación, extra costos y
                    quema al personal.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </SurfaceCard>
      </div>

      <div class="js-problem-card translate-y-4 opacity-0 lg:col-span-6 flex">
        <SurfaceCard
          class="group/card relative flex w-full flex-col p-1 transition-shadow duration-500 hover:shadow-2xl hover:shadow-primary/5"
          tone="brand"
        >
          <div
            class="relative flex h-full flex-col overflow-hidden rounded-2xl bg-background/40 p-6 sm:p-8"
          >
            <div
              class="absolute -bottom-20 -left-20 z-0 h-64 w-64 rounded-full bg-primary/10 blur-[80px] transition-opacity duration-700 group-hover/card:opacity-60"
            >
            </div>

            <header class="relative z-10 mb-6">
              <h3 class="text-xl font-extrabold text-foreground">
                ¿Para quién es crítico?
              </h3>
              <p class="mt-1 text-sm text-muted-foreground">
                Operaciones donde un hueco cuesta dinero o reputación.
              </p>
            </header>

            <div class="relative z-10 grid grid-cols-2 gap-3 h-full">
              <div
                class="group/tile relative overflow-hidden rounded-xl border border-white/5 bg-white/5 p-4 transition-all duration-300 hover:border-primary/30"
              >
                <div
                  class="absolute inset-0 bg-gradient-to-br from-primary/10 to-transparent opacity-0 transition-opacity duration-500 group-hover/tile:opacity-100"
                >
                </div>
                <div class="relative z-10">
                  <svg
                    class="mb-3 size-6 text-primary/70 transition-colors duration-300 group-hover/tile:text-primary"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                    ></path>
                  </svg>
                  <p class="text-sm font-bold text-foreground">Hospitales</p>
                  <p
                    class="mt-0.5 text-[11px] font-medium text-muted-foreground"
                  >
                    UCI y guardias
                  </p>
                </div>
              </div>

              <div
                class="group/tile relative overflow-hidden rounded-xl border border-white/5 bg-white/5 p-4 transition-all duration-300 hover:border-primary/30"
              >
                <div
                  class="absolute inset-0 bg-gradient-to-bl from-primary/10 to-transparent opacity-0 transition-opacity duration-500 group-hover/tile:opacity-100"
                >
                </div>
                <div class="relative z-10">
                  <svg
                    class="mb-3 size-6 text-primary/70 transition-colors duration-300 group-hover/tile:text-primary"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                    ></path>
                  </svg>
                  <p class="text-sm font-bold text-foreground">Seguridad</p>
                  <p
                    class="mt-0.5 text-[11px] font-medium text-muted-foreground"
                  >
                    Cobertura 24/7
                  </p>
                </div>
              </div>

              <div
                class="group/tile relative overflow-hidden rounded-xl border border-white/5 bg-white/5 p-4 transition-all duration-300 hover:border-accent/30"
              >
                <div
                  class="absolute inset-0 bg-gradient-to-tr from-accent/10 to-transparent opacity-0 transition-opacity duration-500 group-hover/tile:opacity-100"
                >
                </div>
                <div class="relative z-10">
                  <svg
                    class="mb-3 size-6 text-accent/70 transition-colors duration-300 group-hover/tile:text-accent"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
                    ></path>
                  </svg>
                  <p class="text-sm font-bold text-foreground">Empresas</p>
                  <p
                    class="mt-0.5 text-[11px] font-medium text-muted-foreground"
                  >
                    Turnos rotativos
                  </p>
                </div>
              </div>

              <div
                class="group/tile relative overflow-hidden rounded-xl border border-white/5 bg-white/5 p-4 transition-all duration-300 hover:border-accent/30"
              >
                <div
                  class="absolute inset-0 bg-gradient-to-tl from-accent/10 to-transparent opacity-0 transition-opacity duration-500 group-hover/tile:opacity-100"
                >
                </div>
                <div class="relative z-10">
                  <svg
                    class="mb-3 size-6 text-accent/70 transition-colors duration-300 group-hover/tile:text-accent"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
                    ></path>
                  </svg>
                  <p class="text-sm font-bold text-foreground">
                    Clínicas / Ind.
                  </p>
                  <p
                    class="mt-0.5 text-[11px] font-medium text-muted-foreground"
                  >
                    Operación continua
                  </p>
                </div>
              </div>
            </div>
          </div>
        </SurfaceCard>
      </div>
    </div>
  </div>
</section>
