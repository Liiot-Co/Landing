---
interface Props {
  title?: string;
  class?: string;
}

const { title = "Vista Hedul", class: className = "" } = Astro.props as Props;
---

<div class={`rounded-xl border border-border/35 bg-card/20 p-3 ${className}`}>
  <div class="mb-3 flex items-center gap-2">
    <span
      class="ml-2 text-[9px] font-semibold uppercase tracking-wider text-muted-foreground/65"
    >
      {title}
    </span>
  </div>
  <slot />
</div>
