---
/**
 * FloatingLogoStage — Logo flotante en pantalla que va acumulando las piezas:
 * "se va armando al hacer scroll al moverse con la pantalla creando el logo del final."
 *
 * - Base completa en GRIS: el isotipo muestra sus 4 piezas en gris en el fondo.
 * - Conforme el usuario scrollea por cada sección (OurStory, HowWeWork, Portfolio, Team):
 *   la pieza del titular se desprende y se suma al logo flotante en su color de marca.
 * - Al llegar a la sección final (Final CTA), culmina ensamblado en la tarjeta.
 */
---

<div
  id="floating-logo-stage"
  class="fixed right-4 sm:right-8 top-20 sm:top-24 z-40 flex items-center gap-2.5 rounded-full border border-border/60 bg-background/80 px-3 py-1.5 backdrop-blur-md shadow-lg opacity-0 pointer-events-none transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] select-none"
  aria-label="Isotipo Liiot construyéndose en pantalla"
>
  <div class="relative size-7 sm:size-8">
    <svg
      viewBox="0 0 48 48"
      class="h-full w-full overflow-visible"
      aria-hidden="true"
    >
      {/* 4 piezas base en gris desde el fondo */}
      <path
        id="floating-p1"
        d="M23.61,40.54l.03-26.58c0-1.17-1.33-1.84-2.26-1.14-2.77,2.1-5.53,4.2-8.3,6.3-.35.27-.56.68-.56,1.13-.03,8.58-.06,17.16-.09,25.74,0,1.13,1.24,1.81,2.18,1.2,2.79-1.82,5.57-3.64,8.36-5.45.4-.26.64-.71.64-1.19"
        class="floating-piece floating-piece--grey"
      />
      <path
        id="floating-p2"
        d="M24.64,7.37l-.03,26.58c0,1.17,1.33,1.84,2.26,1.14,2.77-2.1,5.53-4.2,8.3-6.3.35-.27.56-.68.56-1.13.03-8.58.06-17.16.09-25.74,0-1.13-1.24-1.81-2.18-1.2-2.79,1.82-5.57,3.64-8.36,5.45-.4.26-.64.71-.64,1.19"
        class="floating-piece floating-piece--grey"
      />
      <path
        id="floating-p3"
        d="M35.73,41.84c0,2.93-2.41,5.31-5.39,5.31s-5.65-2.49-5.65-5.56v-5.12h5.58c3.02,0,5.47,2.41,5.47,5.38"
        class="floating-piece floating-piece--grey"
      />
      <path
        id="floating-p4"
        d="M12.52,6.08c0-2.93,2.41-5.31,5.39-5.31s5.65,2.49,5.65,5.56v5.12h-5.58c-3.02,0-5.47-2.41-5.47-5.38"
        class="floating-piece floating-piece--grey"
      />
    </svg>
  </div>

  {/* Contador de armado */}
  <span
    id="floating-logo-counter"
    class="text-[11px] font-mono font-bold tracking-wider text-muted-foreground/80 tabular-nums"
  >
    0/4
  </span>
</div>

<style>
  .floating-piece {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      fill 450ms cubic-bezier(0.34, 1.56, 0.64, 1),
      transform 600ms cubic-bezier(0.34, 1.56, 0.64, 1),
      filter 450ms ease;
  }

  .floating-piece--grey {
    fill: rgba(255, 255, 255, 0.2);
    transform: scale(0.95);
  }
  :global(.light) .floating-piece--grey {
    fill: rgba(11, 7, 16, 0.16);
  }

  /* Piezas desbloqueadas y activadas con color de marca */
  .floating-piece--p1-active {
    fill: var(--primary-high) !important;
    transform: scale(1);
    filter: drop-shadow(0 0 6px var(--primary-high));
  }

  .floating-piece--p2-active {
    fill: var(--accent) !important;
    transform: scale(1);
    filter: drop-shadow(0 0 6px var(--accent));
  }

  .floating-piece--p3-active {
    fill: var(--brand-pink) !important;
    transform: scale(1);
    filter: drop-shadow(0 0 6px var(--brand-pink));
  }

  .floating-piece--p4-active {
    fill: var(--brand-yellow) !important;
    transform: scale(1);
    filter: drop-shadow(0 0 8px var(--brand-yellow));
  }

  /* Celebración al completar las 4 piezas */
  #floating-logo-stage.is-complete {
    border-color: rgba(226, 179, 28, 0.4);
    box-shadow: 0 0 20px rgba(226, 179, 28, 0.25);
    animation: floatingLogoCelebration 1s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  @keyframes floatingLogoCelebration {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }

  @media (prefers-reduced-motion: reduce) {
    #floating-logo-stage {
      display: none !important;
    }
  }
</style>
