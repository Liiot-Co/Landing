---
/**
 * LogoPieceHeading — Elemento decorativo geométrico en cada titular:
 * "cada parte linea o circulo esta como decoración en los headlines y se va
 * armando al hacer scroll al moverse con la pantalla creando el logo del final."
 *
 * Paso 1 (OurStory / El reto):   Línea / Columna izquierda (Violeta Tech: #8B45CC)
 * Paso 2 (HowWeWork / Método):   Línea / Columna derecha (Naranja Humano: #FF6A33)
 * Paso 3 (Portfolio / Logros):   Curva / Círculo inferior (Rosa: #e04b66)
 * Paso 4 (Team / Equipo):        Curva / Círculo superior (Amarillo: #e2b31c)
 *
 * Inicia en un tono gris neutro en el fondo, y al entrar en viewport cobra vida
 * en su color de marca y se prepara para unirse al logo en pantalla.
 */
interface Props {
  step: 1 | 2 | 3 | 4;
  class?: string;
}

const { step, class: className = "" } = Astro.props as Props;

const PIECE_CONFIG = {
  1: {
    type: "line",
    name: "Columna izquierda",
    color: "var(--primary-high)", // #8B45CC
    d: "M23.61,40.54l.03-26.58c0-1.17-1.33-1.84-2.26-1.14-2.77,2.1-5.53,4.2-8.3,6.3-.35.27-.56.68-.56,1.13-.03,8.58-.06,17.16-.09,25.74,0,1.13,1.24,1.81,2.18,1.2,2.79-1.82,5.57-3.64,8.36-5.45.4-.26.64-.71.64-1.19",
  },
  2: {
    type: "line",
    name: "Columna derecha",
    color: "var(--accent)", // #FF6A33
    d: "M24.64,7.37l-.03,26.58c0,1.17,1.33,1.84,2.26,1.14,2.77-2.1,5.53-4.2,8.3-6.3.35-.27.56-.68.56-1.13.03-8.58.06-17.16.09-25.74,0-1.13-1.24-1.81-2.18-1.2-2.79,1.82-5.57,3.64-8.36,5.45-.4.26-.64.71-.64,1.19",
  },
  3: {
    type: "circle",
    name: "Curva inferior",
    color: "var(--brand-pink)", // #e04b66
    d: "M35.73,41.84c0,2.93-2.41,5.31-5.39,5.31s-5.65-2.49-5.65-5.56v-5.12h5.58c3.02,0,5.47,2.41,5.47,5.38",
  },
  4: {
    type: "circle",
    name: "Curva superior",
    color: "var(--brand-yellow)", // #e2b31c
    d: "M12.52,6.08c0-2.93,2.41-5.31,5.39-5.31s5.65,2.49,5.65,5.56v5.12h-5.58c-3.02,0-5.47-2.41-5.47-5.38",
  },
} as const;

const piece = PIECE_CONFIG[step];
---

<div
  class:list={[
    "headline-piece-decorator flex flex-col items-center pt-1 select-none flex-shrink-0 group/piece",
    className,
  ]}
  data-piece-step={step}
  id={`headline-piece-${step}`}
  aria-label={`Decoración ${piece.type}: ${piece.name}`}
>
  <div class="relative size-8 sm:size-9 transition-transform duration-300 hover:scale-110">
    <svg
      viewBox="0 0 48 48"
      class="h-full w-full overflow-visible"
      aria-hidden="true"
    >
      {/* Sombra de apoyo en gris */}
      <path
        d={piece.d}
        class="headline-piece-base"
      />
      {/* Pieza geométrica decorativa activa */}
      <path
        d={piece.d}
        class="headline-piece-active"
        style={`--piece-color: ${piece.color};`}
      />
    </svg>
  </div>

  {/* Conector vertical minimalista con degradado suave hacia el contenido */}
  <span class="w-[1.5px] h-10 sm:h-12 bg-gradient-to-b from-border via-border/50 to-transparent mt-2.5"></span>
</div>

<style>
  .headline-piece-decorator path {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Fondo gris neutro */
  .headline-piece-base {
    fill: rgba(255, 255, 255, 0.16);
    opacity: 0.6;
    transition: opacity 400ms ease;
  }
  :global(.light) .headline-piece-base {
    fill: rgba(11, 7, 16, 0.14);
  }

  /* Pieza activa: inicia en gris tenue, despierta al color de marca en viewport */
  .headline-piece-active {
    fill: rgba(255, 255, 255, 0.28);
    opacity: 0.8;
    transform: scale(0.92);
    transition:
      fill 600ms cubic-bezier(0.34, 1.56, 0.64, 1),
      transform 700ms cubic-bezier(0.34, 1.56, 0.64, 1),
      filter 600ms ease,
      opacity 400ms ease;
  }
  :global(.light) .headline-piece-active {
    fill: rgba(11, 7, 16, 0.22);
  }

  /* Al activarse en scroll */
  .headline-piece-decorator.is-active .headline-piece-active {
    fill: var(--piece-color);
    opacity: 1;
    transform: scale(1);
    filter: drop-shadow(0 0 8px var(--piece-color));
  }

  @media (prefers-reduced-motion: reduce) {
    .headline-piece-active {
      transition: none !important;
      fill: var(--piece-color) !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  function setupHeadlinePieceObservers() {
    const pieces = document.querySelectorAll<HTMLElement>(".headline-piece-decorator:not([data-observed])");
    if (!pieces.length) return;

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-active");
            }
          });
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.2 }
      );

      pieces.forEach((el) => {
        el.setAttribute("data-observed", "1");
        observer.observe(el);
      });
    } else {
      pieces.forEach((el) => el.classList.add("is-active"));
    }
  }

  document.addEventListener("astro:page-load", setupHeadlinePieceObservers);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    setupHeadlinePieceObservers();
  } else {
    document.addEventListener("DOMContentLoaded", setupHeadlinePieceObservers);
  }
</script>
