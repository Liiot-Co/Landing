---
/**
 * "Somos tres" — humaniza al equipo. Fuente: vault §6.
 */
import { Linkedin } from "lucide-astro";
import { TEAM_MEMBERS } from "@/constants/team";
import { unsplashResize, unsplashSrcSet } from "@/lib/images";

const PHOTO_WIDTHS = [400, 700];
---

<section id="equipo" class="relative overflow-hidden bg-surface-secondary py-28 lg:py-36">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div id="team-header" class="mb-16 flex items-start gap-4 sm:gap-6 max-w-2xl translate-y-6 opacity-0 lg:mb-20">
      {/* Eyebrow vertical lateral (de arriba hacia abajo) */}
      <div class="flex flex-col items-center pt-2 select-none flex-shrink-0" aria-hidden="true">
        <span class="size-2 rounded-full bg-primary-high mb-3"></span>
        <span class="section-eyebrow-vertical">
          El equipo
        </span>
        <span class="w-[1px] h-10 bg-gradient-to-b from-border to-transparent mt-3"></span>
      </div>

      <div>
        <h2 class="headline-editorial text-4xl text-foreground sm:text-5xl lg:text-6xl">
          Nuestro <span data-annotate="equipo">equipo</span>
        </h2>
        <p class="mt-6 max-w-md text-sm font-medium leading-relaxed text-muted-foreground sm:text-base">
          Un equipo pequeño que se conoce, se apoya y construye junto, eso se
          nota en cada proyecto.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-x-8 gap-y-14 sm:grid-cols-3">
      {
        TEAM_MEMBERS.map((member) => (
          <a
            href={member.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="js-team-card group block translate-y-6 opacity-0"
          >
            <div class="media-duotone media-duotone-reveal team-photo relative aspect-[3/4] w-full overflow-hidden rounded-2xl">
              <img
                src={unsplashResize(member.photo, 700, 70)}
                srcset={unsplashSrcSet(member.photo, PHOTO_WIDTHS, 70)}
                sizes="(min-width: 640px) 33vw, 90vw"
                alt={member.photoAlt}
                class="team-photo-img h-full w-full object-cover"
                loading="lazy"
              />
              <span
                class="absolute right-3 top-3 z-[2] flex items-center gap-1.5 rounded-full bg-black/40 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-white opacity-0 backdrop-blur-sm transition-opacity duration-300 group-hover:opacity-100"
                aria-hidden="true"
              >
                <span class="size-1.5 animate-pulse rounded-full bg-destructive"></span>
                Live
              </span>
            </div>

            <div class="mt-4 flex items-center justify-between">
              <div>
                <p class="text-lg font-bold tracking-tight text-foreground">{member.name}</p>
                <p class="text-xs font-bold uppercase tracking-[0.15em] text-accent">
                  {member.role}
                </p>
              </div>
              <Linkedin
                class="size-4 text-muted-foreground transition-colors duration-300 group-hover:text-foreground"
                aria-hidden="true"
              />
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .team-photo {
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: box-shadow 450ms cubic-bezier(0.4, 0, 0.2, 1), border-color 450ms ease;
  }

  .team-photo-img {
    filter: grayscale(0.55) contrast(1.1) brightness(0.9);
    transition: filter 450ms cubic-bezier(0.4, 0, 0.2, 1);
    transform: none !important;
  }

  /* Chroma Pop & Neon Glow en hover (sin zoom ni translate) */
  .js-team-card:hover .team-photo,
  .js-team-card:focus-within .team-photo {
    border-color: rgba(255, 255, 255, 0.45);
    box-shadow:
      0 0 34px -4px rgba(139, 69, 204, 0.65),
      0 0 16px rgba(255, 106, 51, 0.5),
      0 14px 28px -8px rgba(0, 0, 0, 0.5);
  }

  .js-team-card:hover .team-photo-img,
  .js-team-card:focus-within .team-photo-img {
    filter: grayscale(0) saturate(1.45) contrast(1.18) brightness(1.04);
  }
</style>
