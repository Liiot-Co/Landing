---
/**
 * "Somos tres" — humaniza al equipo. Fuente: vault §6.
 */
import { Linkedin } from "lucide-astro";
import { TEAM_MEMBERS } from "@/constants/team";
---

<section id="equipo" class="relative overflow-hidden bg-surface-secondary py-28 lg:py-36">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div id="team-header" class="mb-16 max-w-2xl translate-y-6 opacity-0 lg:mb-20">
      <h2 class="headline-editorial text-4xl text-foreground sm:text-5xl lg:text-6xl">
        Somos <span data-annotate="equipo">tres</span>
      </h2>
      <p class="mt-6 max-w-md text-sm font-medium leading-relaxed text-muted-foreground sm:text-base">
        Un equipo pequeño que se conoce, se apoya y construye juntas. Eso se
        nota en el trabajo.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-x-8 gap-y-14 sm:grid-cols-3">
      {
        TEAM_MEMBERS.map((member) => (
          <a
            href={member.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="js-team-card group block translate-y-6 opacity-0"
          >
            <div class="media-duotone media-duotone-reveal team-photo relative aspect-[3/4] w-full overflow-hidden rounded-2xl">
              <img
                src={member.photo}
                alt={member.photoAlt}
                class="team-photo-img h-full w-full object-cover"
                loading="lazy"
              />
              <span
                class="absolute right-3 top-3 z-[2] flex items-center gap-1.5 rounded-full bg-black/40 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-white opacity-0 backdrop-blur-sm transition-opacity duration-300 group-hover:opacity-100"
                aria-hidden="true"
              >
                <span class="size-1.5 animate-pulse rounded-full bg-destructive"></span>
                Live
              </span>
            </div>

            <div class="mt-4 flex items-center justify-between">
              <div>
                <p class="text-lg font-bold tracking-tight text-foreground">{member.name}</p>
                <p class="text-xs font-bold uppercase tracking-[0.15em] text-accent">
                  {member.role}
                </p>
              </div>
              <Linkedin
                class="size-4 text-muted-foreground transition-colors duration-300 group-hover:text-foreground"
                aria-hidden="true"
              />
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* .media-duotone img (global.css) también transiciona `transform` (700ms) —
     eso compite con la animación de abajo: el navegador salta de golpe al
     primer keyframe en vez de dejar que la animación entre en juego, y el
     hover se siente tosco. Acotamos la transición propia a `filter` (la
     reduce a la única propiedad, reutilizando su misma duración/easing por
     posición) y dejamos que la animación sea la única dueña de `transform`. */
  .team-photo-img {
    transition-property: filter;
    /* Encuadre fijo, ligeramente ampliado para tener margen de paneo sin
       dejar huecos — no es el efecto de hover, es el recorte base. */
    transform: scale(1.08);
  }

  /* "Live photo" — paneo lento en loop al hacer hover, simula movimiento sin
     zoom: solo traslada dentro del margen ya dado por el encuadre base.
     Arranca exactamente en el reposo (scale(1.08) translate(0,0)) para que
     la entrada sea continua, no un salto — --dt-easing-flow, rol ambient. */
  .team-photo:hover .team-photo-img,
  .team-photo:focus-within .team-photo-img {
    animation: team-live-pan 4.5s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
  }

  @keyframes team-live-pan {
    from {
      transform: scale(1.08) translate(0, 0);
    }
    to {
      transform: scale(1.08) translate(-3%, 3%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-photo:hover .team-photo-img,
    .team-photo:focus-within .team-photo-img {
      animation: none;
    }
  }
</style>
