---
/**
 * "Somos tres" — humaniza al equipo. Fuente: vault §6.
 */
import { Linkedin } from "lucide-astro";
import { TEAM_MEMBERS, PHOTO_WIDTHS } from "@/constants/team";
import { unsplashResize, unsplashSrcSet } from "@/lib/images";
import SectionFade from "@/components/ui/SectionFade.astro";
import { t } from "@/i18n";
---

<section id="equipo" class="relative overflow-hidden bg-surface-secondary pt-20 pb-16 sm:py-20 lg:py-32 scroll-mt-24">
  {/* Fade suave superior para disolver el salto desde proyectos */}
  <SectionFade position="top" color="background" height="h-28 sm:h-44" zIndex="z-[2]" />
  <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-8 flex flex-col justify-between gap-6 sm:flex-row sm:items-end lg:mb-18">
      <div id="team-header" class="max-w-2xl">
        <h2 class="headline-editorial text-4xl text-foreground sm:text-5xl lg:text-6xl">
          {t.team.titlePrefix} <span data-annotate="equipo">{t.team.titleHighlight}</span>
        </h2>
        <p class="mt-6 max-w-md text-sm font-medium leading-relaxed text-muted-foreground sm:text-base">
          {t.team.subtitle}
        </p>
      </div>

      {/* Pieza decorativa editorial (Curvas de Liiot) a nivel del headline en espacio vacío */}
      <div
        id="editorial-piece-team"
        class="js-boop js-morph-piece hidden sm:flex flex-col items-center justify-end select-none pointer-events-auto cursor-pointer pb-2"
        aria-hidden="true"
        data-color="#FFFFFF"
      >
        <div class="relative size-20 sm:size-24 lg:size-28 opacity-80 transition-transform duration-500 will-change-transform">
          <svg viewBox="0 0 48 48" class="size-full overflow-visible drop-shadow-[0_2px_12px_rgba(255,255,255,0.12)]">
            <path
              d="M35.73,41.84c0,2.93-2.41,5.31-5.39,5.31s-5.65-2.49-5.65-5.56v-5.12h5.58c3.02,0,5.47,2.41,5.47,5.38"
              fill="#FFFFFF"
            />
            <path
              d="M12.52,6.08c0-2.93,2.41-5.31,5.39-5.31s5.65,2.49,5.65,5.56v5.12h-5.58c-3.02,0-5.47-2.41-5.47-5.38"
              fill="#FFFFFF"
            />
          </svg>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-x-8 gap-y-14 sm:grid-cols-3">
      {
        TEAM_MEMBERS.map((member) => (
          <a
            href={member.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="js-team-card group block"
          >
            <div class="media-duotone media-duotone-reveal team-photo relative aspect-[3/4] w-full overflow-hidden rounded-2xl">
              <img
                src={unsplashResize(member.photo, 700, 70)}
                srcset={unsplashSrcSet(member.photo, PHOTO_WIDTHS, 70)}
                sizes="(min-width: 640px) 33vw, 90vw"
                alt={member.photoAlt}
                class="team-photo-img h-full w-full object-cover"
                loading="lazy"
              />
              <span
                class="absolute right-3 top-3 z-[2] flex items-center gap-1.5 rounded-full bg-black/40 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-white opacity-0 backdrop-blur-sm transition-opacity duration-300 group-hover:opacity-100"
                aria-hidden="true"
              >
                <span class="size-1.5 animate-pulse rounded-full bg-destructive"></span>
                {t.team.liveBadge}
              </span>
            </div>

            <div class="mt-4 flex items-center justify-between">
              <div>
                <p class="text-lg font-bold tracking-tight text-foreground">{member.name}</p>
                <p class="text-xs font-bold uppercase tracking-[0.15em] text-accent">
                  {member.role}
                </p>
              </div>
              <Linkedin
                class="size-4 text-muted-foreground transition-colors duration-300 group-hover:text-foreground"
                aria-hidden="true"
              />
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .team-photo {
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: box-shadow 450ms cubic-bezier(0.4, 0, 0.2, 1), border-color 450ms ease;
  }

  .team-photo-img {
    filter: grayscale(0.55) contrast(1.1) brightness(0.9);
    transition: filter 450ms cubic-bezier(0.4, 0, 0.2, 1);
    transform: none !important;
  }

  /* Chroma Pop & Neon Glow en hover (sin zoom ni translate) */
  .js-team-card:hover .team-photo,
  .js-team-card:focus-within .team-photo {
    border-color: rgba(255, 255, 255, 0.45);
    box-shadow:
      0 0 34px -4px rgba(139, 69, 204, 0.65),
      0 0 16px rgba(255, 106, 51, 0.5),
      0 14px 28px -8px rgba(0, 0, 0, 0.5);
  }

  .js-team-card:hover .team-photo-img,
  .js-team-card:focus-within .team-photo-img {
    filter: grayscale(0) saturate(1.45) contrast(1.18) brightness(1.04);
  }
</style>
