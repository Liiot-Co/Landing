---
/**
 * "Misión y visión" — a la izquierda el texto de propósito de Liiot; a la derecha
 * el equipo fundador en media luna alrededor del texto: los nodos se reparten sobre
 * un arco cuyo centro está del lado del texto, así la curva "abraza" la lectura.
 *
 * Coordenadas en un lienzo de 100×158 unidades (mismo viewBox del SVG del arco),
 * así los nodos y el trazo escalan igual en cualquier ancho. El
 * `translate(-50%, -50%)` vive en `.team-node`; la animación de entrada
 * (`.js-team-card`, GSAP) va en el enlace interior para que no se pisen los
 * `transform`.
 */
import { Linkedin } from "lucide-astro";
import { TEAM_MEMBERS, PHOTO_WIDTHS } from "@/constants/team";
import { unsplashResize, unsplashSrcSet } from "@/lib/images";
import SectionFade from "@/components/ui/SectionFade.astro";
import { t } from "@/i18n";

const W = 100;
const H = 158;
const CX = 4; // centro del arco, pegado al lado del texto
const CY = 73; // deja sitio arriba al primer nodo y abajo al último con su nombre
const RADIUS = 66;
const SPAN_DEG = 110; // apertura total de la media luna entre el primer y el último nodo
const rad = (deg: number) => (deg * Math.PI) / 180;

const nodes = TEAM_MEMBERS.map((member, i) => {
  const t0 = TEAM_MEMBERS.length === 1 ? 0 : -SPAN_DEG / 2 + (i * SPAN_DEG) / (TEAM_MEMBERS.length - 1);
  return {
    member,
    x: +((CX + RADIUS * Math.cos(rad(t0))) / W * 100).toFixed(2),
    y: +((CY + RADIUS * Math.sin(rad(t0))) / H * 100).toFixed(2),
  };
});

/** Trazo del arco (de arriba hacia abajo por el lado derecho) a un radio dado. */
const arcPath = (r: number, halfSpan: number) => {
  const p = (deg: number) =>
    `${(CX + r * Math.cos(rad(deg))).toFixed(2)},${(CY + r * Math.sin(rad(deg))).toFixed(2)}`;
  return `M${p(-halfSpan)} A${r},${r} 0 0 1 ${p(halfSpan)}`;
};
---

<section id="equipo" class="relative overflow-hidden bg-surface-secondary pt-20 pb-16 sm:py-20 lg:py-32 scroll-mt-24">
  {/* Fade suave superior para disolver el salto desde proyectos */}
  <SectionFade position="top" color="background" height="h-28 sm:h-44" zIndex="z-[2]" />

  <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-14 lg:grid-cols-2 lg:gap-16">
      {/* Izquierda: misión y visión */}
      <div id="team-header" class="flex max-w-xl flex-col gap-12 lg:gap-14">
        <div>
          <h2 class="headline-editorial text-4xl text-foreground sm:text-5xl lg:text-6xl">
            <span data-annotate="equipo">{t.team.mission.title}</span>
          </h2>
          <p class="mt-5 text-base font-medium leading-relaxed text-foreground/85 sm:text-lg">
            {t.team.mission.text}
          </p>
        </div>

        <div>
          <h2 class="headline-editorial text-4xl text-foreground sm:text-5xl lg:text-6xl">
            {t.team.vision.title}
          </h2>
          <p class="mt-5 text-base font-medium leading-relaxed text-foreground/85 sm:text-lg">
            {t.team.vision.text}
          </p>
        </div>
      </div>

      {/* Derecha: equipo en media luna abierta hacia el texto */}
      <div
        class="team-arc relative mx-auto aspect-[100/158] w-full max-w-[360px] sm:max-w-[440px]"
        role="group"
        aria-label={t.team.orbitAria}
      >
        <svg class="pointer-events-none absolute inset-0 size-full overflow-visible" viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
          <path d={arcPath(RADIUS + 10, 62)} fill="none" stroke="currentColor" stroke-width="0.25" stroke-dasharray="1.2 2.4" opacity="0.7" />
          <path d={arcPath(RADIUS, 58)} fill="none" stroke="currentColor" stroke-width="0.35" opacity="0.6" />
        </svg>

        {
          nodes.map(({ member, x, y }) => (
            <div class="team-node absolute w-[34%]" style={`left:${x}%;top:${y}%`}>
              <a
                href={member.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="js-team-card group block text-center"
              >
                <div class="team-photo relative aspect-square w-full overflow-hidden rounded-full">
                  <img
                    src={unsplashResize(member.photo, 400, 70)}
                    srcset={unsplashSrcSet(member.photo, PHOTO_WIDTHS, 70)}
                    sizes="(min-width: 1024px) 150px, 34vw"
                    alt={member.photoAlt}
                    class="team-photo-img h-full w-full object-cover"
                    loading="lazy"
                  />
                </div>
                <div class="-mx-4 mt-2.5 sm:-mx-8 sm:mt-3.5">
                  <p class="text-xs font-bold leading-tight tracking-tight text-foreground sm:text-lg">
                    {member.name}
                  </p>
                  <p class="mt-1 flex items-center justify-center gap-1.5 text-[10px] font-bold uppercase tracking-[0.12em] text-accent sm:text-xs">
                    {member.role}
                    <Linkedin
                      class="size-3 text-muted-foreground transition-colors duration-300 group-hover:text-foreground sm:size-3.5"
                      aria-hidden="true"
                    />
                  </p>
                </div>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .team-arc {
    color: rgb(255 255 255 / 0.22);
  }

  .team-node {
    transform: translate(-50%, -50%);
  }

  .team-photo {
    border: 1px solid rgba(255, 255, 255, 0.18);
    transition: box-shadow 450ms cubic-bezier(0.4, 0, 0.2, 1), border-color 450ms ease;
  }

  .team-photo-img {
    filter: grayscale(0.55) contrast(1.1) brightness(0.9);
    transition: filter 450ms cubic-bezier(0.4, 0, 0.2, 1);
    transform: none !important;
  }

  /* Chroma Pop & Neon Glow en hover (sin zoom ni translate) */
  .js-team-card:hover .team-photo,
  .js-team-card:focus-visible .team-photo {
    border-color: rgba(255, 255, 255, 0.5);
    box-shadow:
      0 0 34px -4px rgba(139, 69, 204, 0.65),
      0 0 16px rgba(255, 106, 51, 0.5),
      0 14px 28px -8px rgba(0, 0, 0, 0.5);
  }

  .js-team-card:hover .team-photo-img,
  .js-team-card:focus-visible .team-photo-img {
    filter: grayscale(0) saturate(1.45) contrast(1.18) brightness(1.04);
  }

  /* Perf: suspend card hover while actively scrolling (`html.is-scrolling`,
     toggled from landing-motion.ts) so transitions don't recompute mid-scroll;
     resumes 150ms after scrolling stops. */
  html.is-scrolling .js-team-card {
    pointer-events: none;
  }

  html.is-scrolling .team-photo,
  html.is-scrolling .team-photo-img {
    transition: none !important;
  }
</style>
