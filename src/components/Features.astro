---
/**
 * Features — clear micro-UI messages aligned with hero style.
 */
import SectionAmbience from "@/components/ui/SectionAmbience.astro";
import SurfaceCard from "@/components/ui/SurfaceCard.astro";
import IllustrationShell from "@/components/ui/IllustrationShell.astro";
---

<section id="features" class="relative overflow-hidden py-16 lg:py-24">
  <SectionAmbience />

  <div class="container relative mx-auto px-4 sm:px-6 lg:px-8">
    <div
      id="features-header"
      class="mb-10 max-w-2xl translate-y-4 opacity-0 lg:mb-14"
    >
      <p
        class="section-eyebrow mb-3 text-primary font-semibold tracking-wide uppercase text-sm"
      >
        La solución
      </p>
      <h2
        class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl lg:text-5xl"
      >
        Menos caos.<span class="text-gradient"> Más fluidez.</span>
      </h2>
      <p
        class="mt-4 max-w-xl text-base font-medium leading-relaxed text-muted-foreground"
      >
        Tres módulos, tres resultados: planificar, cubrir y equilibrar.
      </p>
    </div>

    <div
      id="features-grid"
      class="mx-auto grid max-w-6xl grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-12 lg:gap-5"
    >
      <div class="js-feature-card translate-y-4 opacity-0 lg:col-span-4">
        <SurfaceCard
          class="group flex h-full min-h-[310px] flex-col p-5 transition-shadow duration-500 hover:shadow-xl hover:shadow-primary/5"
          tone="brand"
        >
          <header class="mb-4 shrink-0">
            <h3 class="text-base font-bold tracking-tight text-foreground">
              Planificación inteligente
            </h3>
            <p
              class="mt-0.5 text-[11px] font-semibold uppercase tracking-wider text-primary"
            >
              Horas -> segundos
            </p>
          </header>

          <IllustrationShell
            title="Hedul Planner"
            class="relative flex min-h-[170px] flex-1 flex-col items-center justify-center overflow-hidden p-4 rounded-xl bg-background/40"
          >
            <div
              class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"
            >
            </div>

            <div class="relative w-full h-full min-h-[120px]">
              <div
                class="js-feat-slot absolute w-[40%] h-6 rounded-md backdrop-blur-sm transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)]
                border border-muted-foreground/30 bg-muted/40 top-[10%] left-[5%] rotate-[-6deg]
                group-hover:top-[15%] group-hover:left-[5%] group-hover:rotate-0 group-hover:border-primary/40 group-hover:bg-primary/20 group-hover:w-[45%]"
              >
              </div>

              <div
                class="js-feat-slot absolute w-[50%] h-6 rounded-md backdrop-blur-sm transition-all duration-700 delay-75 ease-[cubic-bezier(0.22,1,0.36,1)]
                border border-muted-foreground/30 bg-muted/40 top-[40%] left-[20%] rotate-[4deg]
                group-hover:top-[15%] group-hover:left-[52%] group-hover:rotate-0 group-hover:border-accent/40 group-hover:bg-accent/20 group-hover:w-[43%]"
              >
              </div>

              <div
                class="js-feat-slot absolute w-[35%] h-6 rounded-md backdrop-blur-sm transition-all duration-700 delay-100 ease-[cubic-bezier(0.22,1,0.36,1)]
                border border-muted-foreground/30 bg-muted/40 top-[65%] left-[50%] rotate-[-3deg]
                group-hover:top-[45%] group-hover:left-[5%] group-hover:rotate-0 group-hover:border-chart-5/40 group-hover:bg-chart-5/20 group-hover:w-[30%]"
              >
              </div>

              <div
                class="js-feat-slot absolute w-[45%] h-6 rounded-md backdrop-blur-sm transition-all duration-700 delay-150 ease-[cubic-bezier(0.22,1,0.36,1)]
                border border-muted-foreground/30 bg-muted/40 top-[75%] left-[10%] rotate-[8deg]
                group-hover:top-[45%] group-hover:left-[37%] group-hover:rotate-0 group-hover:border-primary/40 group-hover:bg-primary/30 group-hover:w-[58%]"
              >
              </div>
            </div>
          </IllustrationShell>
        </SurfaceCard>
      </div>

      <div class="js-feature-card translate-y-4 opacity-0 lg:col-span-4">
        <SurfaceCard
          class="group flex h-full min-h-[310px] flex-col p-5 transition-shadow duration-500 hover:shadow-xl hover:shadow-accent/5"
          tone="brand"
        >
          <header class="mb-4 shrink-0">
            <h3 class="text-base font-bold tracking-tight text-foreground">
              Sustitución automática
            </h3>
            <p
              class="mt-0.5 text-[11px] font-semibold uppercase tracking-wider text-accent"
            >
              Turno cubierto al instante
            </p>
          </header>

          <IllustrationShell
            title="Hedul Coverage"
            class="relative flex min-h-[170px] flex-1 flex-col justify-center overflow-hidden p-3 rounded-xl bg-background/40"
          >
            <div class="w-full space-y-3 relative z-10">
              <div class="flex items-center gap-2 px-1">
                <div class="size-5 rounded-full bg-muted flex-shrink-0"></div>
                <div class="grid grid-cols-4 gap-1.5 w-full">
                  <div
                    class="js-feat-slot h-6 rounded border border-primary/20 bg-primary/10"
                  >
                  </div>

                  <div
                    class="js-feat-slot relative h-6 rounded border-2 border-dashed border-destructive/40 bg-destructive/5 overflow-hidden"
                  >
                    <div
                      class="absolute inset-0 origin-left scale-x-0 bg-gradient-to-r from-accent/80 to-accent transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-x-100"
                    >
                    </div>
                  </div>

                  <div
                    class="js-feat-slot h-6 rounded border border-primary/20 bg-primary/10"
                  >
                  </div>
                  <div
                    class="js-feat-slot h-6 rounded border border-primary/20 bg-primary/10"
                  >
                  </div>
                </div>
              </div>

              <div
                class="flex items-center gap-2 px-1 transition-opacity duration-500 group-hover:opacity-40"
              >
                <div class="size-5 rounded-full bg-accent/20 flex-shrink-0">
                </div>
                <div class="grid grid-cols-4 gap-1.5 w-full">
                  <div
                    class="js-feat-slot h-6 rounded border border-border/40 bg-muted/20"
                  >
                  </div>
                  <div
                    class="js-feat-slot relative h-6 rounded border border-accent/40 bg-accent/20 transition-all duration-500 group-hover:scale-95 group-hover:border-dashed group-hover:bg-transparent"
                  >
                  </div>
                  <div
                    class="js-feat-slot h-6 rounded border border-border/40 bg-muted/20"
                  >
                  </div>
                  <div
                    class="js-feat-slot h-6 rounded border border-border/40 bg-muted/20"
                  >
                  </div>
                </div>
              </div>
            </div>

            <div
              class="absolute bottom-3 right-3 z-20 flex translate-y-4 scale-95 items-center gap-1.5 rounded-lg border border-accent/30 bg-card/95 px-2.5 py-1.5 opacity-0 shadow-lg backdrop-blur-md transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-y-0 group-hover:scale-100 group-hover:opacity-100 delay-300"
            >
              <span
                class="flex size-4 items-center justify-center rounded-full bg-accent/20"
              >
                <svg
                  class="size-2.5 text-accent"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="3"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M5 13l4 4L19 7"></path>
                </svg>
              </span>
              <span
                class="text-[9px] font-bold uppercase tracking-wider text-foreground"
                >Sustituido</span
              >
            </div>
          </IllustrationShell>
        </SurfaceCard>
      </div>

      <div class="js-feature-card translate-y-4 opacity-0 lg:col-span-4">
        <SurfaceCard
          class="group flex h-full min-h-[310px] flex-col p-5 transition-shadow duration-500 hover:shadow-xl hover:shadow-chart-5/5"
          tone="brand"
        >
          <header class="mb-4 shrink-0">
            <h3 class="text-base font-bold tracking-tight text-foreground">
              Carga justa
            </h3>
            <p
              class="mt-0.5 text-[11px] font-semibold uppercase tracking-wider text-chart-5"
            >
              Menos sobrecarga
            </p>
          </header>

          <IllustrationShell
            title="Hedul Balance"
            class="relative flex min-h-[170px] flex-1 flex-col items-center justify-end overflow-hidden p-4 rounded-xl bg-background/40"
          >
            <div
              class="absolute top-[40%] left-0 right-0 flex items-center px-2 z-0"
            >
              <div
                class="h-[1px] w-full border-t border-dashed border-primary/30"
              >
              </div>
              <span class="ml-2 text-[9px] font-bold text-primary/60">40h</span>
            </div>

            <div
              class="flex h-[110px] w-full items-end justify-between px-2 relative z-10 gap-2"
            >
              <div
                class="group/bar relative flex w-full flex-col justify-end h-[95%] transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:h-[60%]"
              >
                <div
                  class="js-feat-slot w-full rounded-t-md bg-destructive/60 border-t border-x border-destructive transition-colors duration-700 group-hover:bg-primary/40 group-hover:border-primary/50 h-full"
                >
                </div>
              </div>

              <div
                class="group/bar relative flex w-full flex-col justify-end h-[85%] transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:h-[55%] delay-75"
              >
                <div
                  class="js-feat-slot w-full rounded-t-md bg-destructive/50 border-t border-x border-destructive/80 transition-colors duration-700 group-hover:bg-accent/40 group-hover:border-accent/50 h-full"
                >
                </div>
              </div>

              <div
                class="group/bar relative flex w-full flex-col justify-end h-[25%] transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:h-[50%] delay-100"
              >
                <div
                  class="js-feat-slot w-full rounded-t-md bg-muted border-t border-x border-border transition-colors duration-700 group-hover:bg-chart-5/40 group-hover:border-chart-5/50 h-full"
                >
                </div>
              </div>

              <div
                class="group/bar relative flex w-full flex-col justify-end h-[35%] transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:h-[65%] delay-150"
              >
                <div
                  class="js-feat-slot w-full rounded-t-md bg-muted border-t border-x border-border transition-colors duration-700 group-hover:bg-primary/30 group-hover:border-primary/40 h-full"
                >
                </div>
              </div>
            </div>

            <div class="w-full h-[1px] bg-border/80 mt-1 relative z-20"></div>
          </IllustrationShell>
        </SurfaceCard>
      </div>
    </div>
  </div>
</section>
