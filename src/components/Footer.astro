---
/**
 * Footer — cierre limpio. Solo el logo (mediano), sin wordmark gigante.
 * Fuente: vault §8.
 */
import { Linkedin, Instagram } from "lucide-astro";
import LiiotMark from "@/components/ui/LiiotMarkAnimated.astro";
import MorphGradient from "@/components/ui/MorphGradient.astro";
import { LIIOT_EMAIL, LIIOT_INSTAGRAM_URL, LIIOT_LINKEDIN_URL } from "@/constants/contact";

const currentYear = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-background pt-24 pb-10">
  <MorphGradient recipe="aurora" blend="screen" opacity={0.22} />

  <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-start gap-14 sm:flex-row sm:items-start sm:justify-between">
        <div id="footer-mark" class="flex cursor-pointer translate-y-6 items-center gap-3 opacity-0">
        <LiiotMark class="size-10" color="white" />
        <span class="text-3xl font-bold tracking-tight text-foreground">Liiot</span>
      </div>

      <div class="flex flex-col gap-8 sm:flex-row sm:gap-16">
        <div class="flex flex-col gap-2">
          <p class="text-xs font-bold tracking-[0.2em] uppercase text-muted-foreground mb-1">Contacto</p>
          <a
            href={`mailto:${LIIOT_EMAIL}`}
            class="text-sm font-medium text-foreground transition-colors hover:text-accent"
          >
            {LIIOT_EMAIL}
          </a>
        </div>

        <div class="flex flex-col gap-2">
          <p class="text-xs font-bold tracking-[0.2em] uppercase text-muted-foreground mb-1">Redes</p>
          <div class="flex items-center gap-4">
            <a
              href={LIIOT_LINKEDIN_URL}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Liiot en LinkedIn"
              class="text-muted-foreground transition-colors hover:text-accent"
            >
              <Linkedin class="size-5" />
            </a>
            <a
              href={LIIOT_INSTAGRAM_URL}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Liiot en Instagram"
              class="text-muted-foreground transition-colors hover:text-accent"
            >
              <Instagram class="size-5" />
            </a>
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <p class="text-xs font-bold tracking-[0.2em] uppercase text-muted-foreground mb-1">Legal</p>
          <a href="#" class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground">
            Privacidad
          </a>
          <a href="#" class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground">
            Términos
          </a>
        </div>
      </div>
    </div>

    <p class="mt-14 max-w-xs text-sm font-medium leading-relaxed text-muted-foreground">
      Jóvenes, serios y con ganas de construir. Hecho en Colombia.
    </p>

    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-border pt-6 sm:flex-row">
      <p class="text-xs text-muted-foreground">
        &copy; {currentYear} Liiot. Todos los derechos reservados.
      </p>
      <a href="#hero" class="text-xs font-medium text-muted-foreground transition-colors hover:text-foreground">
        Volver arriba &uarr;
      </a>
    </div>
  </div>
</footer>
