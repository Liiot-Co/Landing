---
// Importaciones de iconos de Lucide-Astro
import { Shield, Zap, Users, Award, TrendingUp, Lock } from 'lucide-astro';

const benefits = [
    {
        icon: Shield,
        title: "Seguridad Empresarial",
        description: "Infraestructura segura con cifrado de datos de nivel bancario. Cumplimiento con normativas internacionales de protección de información.",
    },
    {
        icon: Zap,
        title: "Rendimiento Superior",
        description: "Rendimiento confiable y estable garantizado para continuidad operativa sin interrupciones. 99.9% de tiempo de actividad.",
    },
    {
        icon: Users,
        title: "Diseño Colaborativo",
        description: "Construido para la colaboración con sincronización en tiempo real e integraciones perfectas con sus herramientas existentes.",
    },
    {
        icon: Award,
        title: "Soporte Especializado",
        description: "Equipo de expertos dedicado a garantizar precisión y consistencia en sus flujos de trabajo. Respuesta en menos de 2 horas.",
    },
    {
        icon: TrendingUp,
        title: "Escalable con su Crecimiento",
        description: "Nuestra infraestructura crece junto con su empresa. Desde startups hasta corporaciones multinacionales.",
    },
    {
        icon: Lock,
        title: "Propiedad de Datos",
        description: "Sus datos son suyos. Exporte en cualquier momento sin restricciones. Sin dependencia del proveedor.",
    },
];

// Definición de selectores
const SECTION_ID = "why-choose-us";
const HEADER_ID = "why-choose-us-header";
---

<section id={SECTION_ID} class="py-24 lg:py-28 bg-card/50 relative overflow-hidden">
    <!-- GeometricAccent Replacement (Simulado con SVG para evitar dependencias externas) -->
    <div class="absolute top-0 left-0 text-primary/5 pointer-events-none">
       <svg width="500" height="500" viewBox="0 0 500 500" fill="none" xmlns="http://www.w3.org/2000/svg">
         <circle cx="250" cy="250" r="200" stroke="currentColor" stroke-width="40" />
         <circle cx="250" cy="250" r="100" stroke="currentColor" stroke-width="20" stroke-opacity="0.5" />
       </svg>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative">
        
        {/* HEADER (Animación simple de fade-up) */}
        <div 
          id={HEADER_ID} 
          class="text-center mb-16 opacity-0 translate-y-4"
        >
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6">
            ¿Por Qué Elegir <span class="text-gradient">Nuestra Plataforma</span>?
          </h2>
          <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
            Herramientas potentes diseñadas para empresas que exigen excelencia, precisión y resultados medibles. Maximice su ROI con tecnología de vanguardia.
          </p>
        </div>

        {/* BENEFITS GRID (Animación escalonada con stagger) */}
        <div
          id="benefit-grid-container"
          class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto"
        >
          {benefits.map((benefit, index) => (
            <div
              class="benefit-card group relative opacity-0 translate-y-4"
              data-index={index}
            >
              <div class="h-full p-8 rounded-2xl border border-border bg-card hover:shadow-lg hover:border-primary/30 hover:brightness-110 hover:scale-[1.03] transition-all duration-300">
                <div class="w-14 h-14 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-all duration-300">
                  <benefit.icon class="w-7 h-7 text-primary" />
                </div>
                <h3 class="text-xl font-semibold mb-3">
                  {benefit.title}
                </h3>
                <p class="text-muted-foreground leading-relaxed">
                  {benefit.description}
                </p>
              </div>
            </div>
          ))}
        </div>
    </div>
</section>

<script>
    import { animate, inView, stagger, type StaggerOrigin } from "motion";

    // Selectores definidos en el frontmatter (Astro las inyecta)
    const SECTION_ID = "#why-choose-us";
    const HEADER_ID = "#why-choose-us-header";
    const ITEM_CLASS = ".benefit-card"; 

    // Estados Finales (Reseteamos transforms)
    const fadeUp = { opacity: 1, transform: "none" };

    // Configuración de animación
    const headerOpts = { duration: 0.5, easing: "ease-out" };
    const itemOpts = { duration: 0.4, easing: "ease-out" };

    // Trigger de la animación cuando la sección entra en el viewport
    inView(SECTION_ID, (element) => {
        
        // 1. Animación del Header
        animate(HEADER_ID, fadeUp, headerOpts);

        // 2. Animación Escalonda (Stagger) de las tarjetas de Beneficios
        const items = element.querySelectorAll(ITEM_CLASS);
        
        // La animación escalonada se activa después de un pequeño delay (ej: 0.2s)
        animate(items, fadeUp, { 
            delay: stagger(0.08, { from: "start" as StaggerOrigin }),
            duration: 0.4,
            ease: "easeOut" as const,
        });

    }, { margin: "-100px 0px 0px 0px" }); // Margin similar al original de Framer Motion
</script>
