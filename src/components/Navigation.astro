---
import { Menu, X } from 'lucide-astro';
import Button from "@/components/ui/button.astro";
import { cn } from "@/lib/utils";

// --- Datos ---
const navLinks = [
  { name: "Home", path: "/" },
  { name: "Products", path: "/products" },
];

// Obtenemos el path actual para la renderización inicial del estado activo
const currentPath = Astro.url.pathname;

const NAV_ID = "main-navigation";
const MOBILE_TOGGLE_ID = "mobile-menu-toggle";
const MOBILE_MENU_ID = "mobile-menu";
---

<nav
  id={NAV_ID}
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      {/* Logo */}
      <a href="/" class="flex items-center space-x-2 group">
        <div class="w-8 h-8 rounded-lg bg-primary flex items-center justify-center transition-transform group-hover:scale-110">
          <span class="text-primary-foreground font-bold text-lg">S</span>
        </div>
        <span class="text-xl sm:text-2xl font-bold text-foreground">
          SoftwareCo
        </span>
      </a>

      {/* Desktop Navigation */}
      <div class="hidden md:flex items-center space-x-8">
        {navLinks.map((link) => (
          <a
            href={link.path}
            class={cn(
              "text-sm font-medium transition-colors relative py-2",
              currentPath === link.path
                ? "text-primary"
                : "text-muted-foreground hover:text-foreground"
            )}
          >
            {link.name}
            {currentPath === link.path && (
              <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-primary rounded-full" />
            )}
          </a>
        ))}
        <Button asChild class="bg-primary text-primary-foreground hover:bg-primary/90">
          <a href="#demo">Get Started</a>
        </Button>
      </div>

      {/* Mobile Menu Button */}
      <button
        id={MOBILE_TOGGLE_ID}
        class="md:hidden p-2 text-foreground"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
      >
        <Menu id="menu-icon" class="w-6 h-6" />
        <X id="close-icon" class="w-6 h-6 hidden" />
      </button>
    </div>

    {/* Mobile Menu (Hidden by default, shown by JS) */}
    <div 
      id={MOBILE_MENU_ID} 
      class="md:hidden py-4 border-t border-border hidden"
    >
      <div class="flex flex-col space-y-4">
        {navLinks.map((link) => (
          <a
            href={link.path}
            class={cn(
              "text-sm font-medium transition-colors px-2 py-2",
              currentPath === link.path
                ? "text-primary"
                : "text-muted-foreground hover:text-foreground"
            )}
            data-mobile-link
          >
            {link.name}
          </a>
        ))}
        <Button asChild class="bg-primary text-primary-foreground hover:bg-primary/90 w-full">
          <a href="#demo">Get Started</a>
        </Button>   
      </div>
    </div>
  </div>
</nav>

<script define:vars={{ NAV_ID, MOBILE_TOGGLE_ID, MOBILE_MENU_ID, cn }}>
  
  // Script del lado del cliente para manejar el estado dinámico

  const nav = document.getElementById(NAV_ID);
  const toggleButton = document.getElementById(MOBILE_TOGGLE_ID);
  const mobileMenu = document.getElementById(MOBILE_MENU_ID);
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');
  
  if (!nav || !toggleButton || !mobileMenu || !menuIcon || !closeIcon) return;

  let isScrolled = false;
  let isMobileMenuOpen = false;

  const SCROLLED_CLASSES = "bg-background/80 backdrop-blur-lg border-b border-border";
  const UN_SCROLLED_CLASSES = "bg-transparent";

  // Maneja el estado de scroll de la barra de navegación
  const handleScroll = () => {
    const newIsScrolled = window.scrollY > 20;

    if (newIsScrolled !== isScrolled) {
      isScrolled = newIsScrolled;
      
      if (isScrolled) {
        // Añadir clases de scroll y quitar transparentes
        nav.classList.add(...SCROLLED_CLASSES.split(' '));
        nav.classList.remove(...UN_SCROLLED_CLASSES.split(' '));
      } else {
        // Añadir clases transparentes y quitar scroll
        nav.classList.add(...UN_SCROLLED_CLASSES.split(' '));
        nav.classList.remove(...SCROLLED_CLASSES.split(' '));
      }
    }
  };
  
  // Maneja el estado del menú móvil
  const handleMobileToggle = () => {
    isMobileMenuOpen = !isMobileMenuOpen;
    toggleButton.setAttribute('aria-expanded', isMobileMenuOpen ? 'true' : 'false');

    if (isMobileMenuOpen) {
      mobileMenu.classList.remove('hidden');
      menuIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
    } else {
      mobileMenu.classList.add('hidden');
      menuIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
    }
  };

  // Cierra el menú móvil al hacer clic en un enlace
  const closeMobileMenu = () => {
    if (isMobileMenuOpen) {
      handleMobileToggle();
    }
  };

  // Inicialización de listeners
  window.addEventListener("scroll", handleScroll);
  toggleButton.addEventListener("click", handleMobileToggle);
  
  // Listener para cerrar el menú al hacer clic en un enlace interno
  mobileMenu.querySelectorAll('a[data-mobile-link]').forEach(link => {
    link.addEventListener('click', closeMobileMenu);
  });
  
  // Llamada inicial para establecer el estado del scroll
  handleScroll();
  
  // Retorno de limpieza (opcional en Astro, pero buena práctica)
  return () => {
    window.removeEventListener("scroll", handleScroll);
    toggleButton.removeEventListener("click", handleMobileToggle);
    mobileMenu.querySelectorAll('a[data-mobile-link]').forEach(link => {
      link.removeEventListener('click', closeMobileMenu);
    });
  }

</script>