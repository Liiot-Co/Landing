---
import "@/styles/global.css";
import SEO from "@/components/seo/SEO.astro";
import { IMAGES, HERO_IMAGE, HERO_IMAGE_WIDTHS } from "@/constants/images";
import { unsplashResize, unsplashSrcSet } from "@/lib/images";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
}

const { title, description, image, canonical, noindex } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={IMAGES.seo.favicon} />
    <meta name="generator" content={Astro.generator} />

    {/* Preconnect al origen externo crítico restante (imagen LCP del Hero) */}
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />

    {/* Precarga de la imagen LCP del Hero, con las mismas variantes que consume <img> ahí */}
    <link
      rel="preload"
      as="image"
      href={unsplashResize(HERO_IMAGE, 1536, 65)}
      imagesrcset={unsplashSrcSet(HERO_IMAGE, HERO_IMAGE_WIDTHS, 65)}
      imagesizes="100vw"
      fetchpriority="high"
    />

    {/* Fuentes auto-hospedadas en `public/fonts`: preload solo de Satoshi
        (la principal); Open Sans es fallback y se pide solo si hace falta */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/satoshi-variable.woff2"
      crossorigin
      fetchpriority="high"
    />
    <SEO
      title={title}
      description={description}
      image={image}
      canonical={canonical}
      noindex={noindex}
    />
  </head>
  <body class="dark noise-overlay">
    <slot />
    <script>
      import "@/scripts/landing-motion.ts";
    </script>
  </body>
</html>
