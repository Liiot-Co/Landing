---
import { Calendar, Users, Clock, ArrowRight } from 'lucide-astro';
// Asumimos que tienes el componente Button.astro en la misma carpeta.
// Si no, puedes cambiar esto por un elemento <button> o <a> estándar con clases.
import Button from '@/components/ui/button.astro';

const features = [
    {
        icon: Calendar,
        title: "Planificación Inteligente",
        description: "Optimización automática de calendarios con IA que ahorra horas cada semana y aumenta la productividad de su equipo",
    },
    {
        icon: Users,
        title: "Coordinación de Equipos",
        description: "Herramientas de colaboración perfectas para equipos distribuidos, mejorando la comunicación y eficiencia operativa",
    },
    {
        icon: Clock,
        title: "Seguimiento de Tiempo",
        description: "Registro automático de tiempo y análisis de productividad que le permite tomar decisiones basadas en datos reales",
    },
];
---

<section id="product-spotlight" class="py-24 lg:py-32 relative overflow-hidden">
    <!-- GeometricAccent Replacement (Simulado con SVG para evitar dependencias externas) -->
    <div class="absolute top-0 right-0 transform scale-x-[-1] text-primary/5 pointer-events-none">
       <svg width="500" height="500" viewBox="0 0 500 500" fill="none" xmlns="http://www.w3.org/2000/svg">
         <circle cx="250" cy="250" r="200" stroke="currentColor" stroke-width="40" />
         <circle cx="250" cy="250" r="100" stroke="currentColor" stroke-width="20" stroke-opacity="0.5" />
       </svg>
    </div>

    <!-- Background Gradient -->
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-primary/5 to-transparent pointer-events-none"></div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative">
        <div class="max-w-6xl mx-auto">
            
            {/* HEADER
                Initial: opacity: 0, y: 15 (aprox translate-y-4/8)
            */}
            <div id="spotlight-header" class="text-center mb-16 opacity-0 translate-y-8">
                <div class="inline-block mb-4">
                    <span class="text-primary font-semibold text-sm uppercase tracking-wider">Producto Destacado</span>
                </div>
                <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6">
                    Software de Planificación Empresarial
                </h2>
                <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
                    La herramienta de planificación más potente para empresas modernas. Organice, coordine y optimice el tiempo de su equipo con automatización inteligente que reduce costos operativos.
                </p>
            </div>

            <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center mb-16">
                
                {/* IMAGE / MOCKUP 
                    Initial: opacity: 0, x: -15 (aprox -translate-x-4)
                */}
                <div id="spotlight-image" class="relative opacity-0 -translate-x-4">
                    <div class="relative rounded-2xl overflow-hidden border border-border bg-card p-8 shadow-sm hover:shadow-lg hover:border-primary/30 hover:brightness-110 transition-all duration-300">
                        <div class="aspect-[4/3] bg-linear-to-br from-muted to-muted/50 rounded-lg flex items-center justify-center">
                            <div class="text-center">
                                <Calendar class="w-24 h-24 text-primary mx-auto mb-4 opacity-50" />
                                <p class="text-muted-foreground text-sm">Vista Previa del Producto</p>
                            </div>
                        </div>
                    </div>
                    {/* Floating accent element */}
                    <div class="absolute -top-6 -right-6 w-32 h-32 bg-primary/20 rounded-full blur-3xl pointer-events-none"></div>
                </div>

                {/* FEATURES LIST CONTAINER
                    Initial: opacity: 0, x: 15 (aprox translate-x-4)
                */}
                <div id="spotlight-features" class="space-y-8 opacity-0 translate-x-4">
                    {features.map((feature, index) => (
                        <div class="feature-item flex items-start space-x-4 group opacity-0 translate-y-4">
                            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-primary/10 border border-primary/20 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
                                <feature.icon class="w-6 h-6 text-primary" />
                            </div>
                            <div>
                                <h3 class="text-lg font-semibold mb-2">{feature.title}</h3>
                                <p class="text-muted-foreground">{feature.description}</p>
                            </div>
                        </div>
                    ))}

                    <a href="/products" class="inline-block mt-4">
                        <button
                          class="relative px-6 py-3 text-base font-semibold rounded-md
                            bg-[var(--accent)]
                            text-[var(--accent-foreground)]
                            hover:bg-[color-mix(in_oklch,var(--accent)_85%,black)]
                            shadow-lg shadow-[color-mix(in_oklch,var(--accent)_30%,transparent)]
                            overflow-hidden group cta-button-accent
                            transition-all duration-300
                            w-full sm:w-auto
                            inline-flex items-center justify-center gap-2"
                        >
                          <span class="relative z-10 flex items-center">
                            Conocer Más Sobre Nuestra Plataforma
                            <ArrowRight class="ml-2 h-4 w-4 transition-transform group-hover:translate-x-1" />
                          </span>
                          <span
                            class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500
                              bg-[linear-gradient(120deg,transparent,rgba(255,255,255,0.35),transparent)]
                              animate-shimmer pointer-events-none">
                          </span>
                        </button>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { animate, inView, stagger, type StaggerOrigin } from "motion";

    // Selectores
    const section = "#product-spotlight";
    const header = "#spotlight-header";
    const image = "#spotlight-image";
    const featuresContainer = "#spotlight-features";
    // El selector de clase ahora es una constante de string
    const featureItemsSelector = ".feature-item"; 

    // Estados Finales (Reseteamos transforms)
    const fadeUp = { opacity: 1, transform: "none" };
    const fadeSlideIn = { opacity: 1, transform: "none" };

    // Configuración de animación
    const opts = { duration: 0.5, easing: "ease-out" };

    // Trigger cuando la sección entra en el viewport (con margen de -100px)
    inView(section, () => {
        
        // 1. Header
        animate(header, fadeUp, { ...opts });

        // 2. Imagen (Delay 0.1s)
        animate(image, fadeSlideIn, { ...opts, duration: 0.6, delay: 0.1 });

        // 3. Contenedor de Features (Delay 0.2s)
        animate(featuresContainer, fadeSlideIn, { ...opts, duration: 0.6, delay: 0.2 });
        
        // CORRECCIÓN: Obtenemos explícitamente la NodeList de elementos.
        // Esto resuelve la ambigüedad de tipos al usar un selector de clase en `animate()`.
        const featureItems = document.querySelectorAll(featureItemsSelector);

        // 4. Items individuales de Features (Stagger desde 0.3s)
        animate(featureItems, fadeUp, { 
            delay: stagger(0.05, { from: "start" as StaggerOrigin }),
            duration: 0.4,
            ease: "easeOut" as const,
        });

    }, { margin: "-100px 0px 0px 0px" });
</script>