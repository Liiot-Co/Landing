---
const CANVAS_ID = "liiot-branding-canvas";
---

<div
    class="absolute inset-0 w-full h-full overflow-hidden bg-[#05010a] pointer-events-none hero-canvas-fade-out"
>
    <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_18%_22%,color-mix(in_oklch,var(--primary)_32%,black)_0%,transparent_48%),radial-gradient(circle_at_82%_20%,color-mix(in_oklch,var(--accent)_24%,black)_0%,transparent_44%),linear-gradient(160deg,#05010a_0%,color-mix(in_oklch,var(--primary)_16%,black)_56%,#020106_100%)]"
    >
    </div>
    <div class="absolute inset-0 w-full h-full pointer-events-none">
        <canvas id={CANVAS_ID} class="block w-full h-full"></canvas>
        <div
            class="absolute inset-0 opacity-[0.04] mix-blend-overlay bg-[url('https://grainy-gradients.vercel.app/noise.svg')]"
        >
        </div>
    </div>
</div>

<script>
    // @ts-ignore - loaded from CDN for runtime use in Astro component script
    import * as THREE from "https://esm.sh/three@0.160.0";

    class LiiotBrandingEffect {
        canvas: HTMLCanvasElement;
        renderer: any;
        scene: any;
        camera: any;
        material: any;

        mouse: any;
        targetMouse: any;

        constructor(canvas: HTMLCanvasElement) {
            this.canvas = canvas;
            this.init();
        }

        private getThemeColors() {
            const rootStyle = getComputedStyle(document.documentElement);

            const parseColor = (varName: string, fallbackHex: string) => {
                const cssValue = rootStyle.getPropertyValue(varName).trim();
                const colorToParse = cssValue || fallbackHex;

                const tempCanvas = document.createElement("canvas");
                tempCanvas.width = 1;
                tempCanvas.height = 1;
                const ctx = tempCanvas.getContext("2d");

                if (ctx) {
                    ctx.fillStyle = fallbackHex;
                    ctx.fillStyle = colorToParse;
                    ctx.fillRect(0, 0, 1, 1);

                    const [r, g, b] = ctx.getImageData(0, 0, 1, 1).data;
                    return new THREE.Color(`rgb(${r}, ${g}, ${b})`);
                }

                return new THREE.Color(fallbackHex);
            };

            return {
                primary: parseColor("--primary", "#28004f"),
                accent: parseColor("--accent", "#f54d02"),
                secondary: parseColor("--secondary", "#c3b6d2"),
                bg: parseColor("--background", "#05010a"),
            };
        }

        init() {
            const colors = this.getThemeColors();
            this.scene = new THREE.Scene();
            this.camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
            this.mouse = new THREE.Vector2(0.5, 0.5);
            this.targetMouse = new THREE.Vector2(0.5, 0.5);

            this.renderer = new THREE.WebGLRenderer({
                canvas: this.canvas,
                antialias: true,
                alpha: true,
            });

            this.renderer.setSize(window.innerWidth, window.innerHeight);
            this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

            this.material = new THREE.ShaderMaterial({
                uniforms: {
                    uTime: { value: 0 },
                    uMouse: { value: this.mouse },
                    uColor1: { value: colors.primary },
                    uColor2: { value: colors.accent },
                    uColor3: { value: colors.secondary },
                    uColorBg: { value: colors.bg },
                },
                vertexShader: `
          varying vec2 vUv;
          void main() {
            vUv = uv;
            gl_Position = vec4(position, 1.0);
          }
        `,
                fragmentShader: `
          uniform float uTime;
          uniform vec2 uMouse;
          uniform vec3 uColor1;
          uniform vec3 uColor2;
          uniform vec3 uColor3;
          uniform vec3 uColorBg;
          varying vec2 vUv;

          // Texture generator
          float random(vec2 st) {
              return fract(sin(dot(st.xy, vec2(12.9898,78.233))) * 43758.5453123);
          }

          float hash21(vec2 p) {
            p = fract(p * vec2(234.34, 824.21));
            p += dot(p, p + 34.45);
            return fract(p.x * p.y);
          }

          float noise(vec2 p) {
            vec2 i = floor(p);
            vec2 f = fract(p);
            vec2 u = f * f * (3.0 - 2.0 * f);
            float a = hash21(i);
            float b = hash21(i + vec2(1.0, 0.0));
            float c = hash21(i + vec2(0.0, 1.0));
            float d = hash21(i + vec2(1.0, 1.0));
            return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
          }

          float blob(vec2 uv, vec2 center, float radius) {
            float d = distance(uv, center);
            return smoothstep(radius, 0.0, d);
          }

          void main() {
            vec2 uv = vUv;
            float t = uTime * 0.035;
            
            // Interaction: Mouse distorts the fluid space instead of dragging the blobs
            vec2 m = uMouse * 0.5;
            float flowDistortion = noise(uv * 3.0 + vec2(t * 0.5, m.x)) * 0.12;
            vec2 distortedUv = uv + vec2(flowDistortion, noise(uv * 3.0 - vec2(m.y, t * 0.5)) * 0.12);

            // Autonomous drifting anchors (no mouse parallax here anymore)
            vec2 c1 = vec2(0.24 + 0.08 * sin(t * 1.3), 0.72 + 0.06 * cos(t * 0.9));
            vec2 c2 = vec2(0.52 + 0.10 * sin(t * 0.8 + 1.2), 0.50 + 0.07 * cos(t * 1.1));
            vec2 c3 = vec2(0.84 + 0.06 * cos(t * 0.7 + 2.4), 0.20 + 0.05 * sin(t * 1.0));
            vec2 c4 = vec2(0.72 + 0.06 * sin(t * 0.6), 0.82 + 0.04 * cos(t * 1.2));

            float purpleA = blob(distortedUv, c1, 0.78);
            float purpleB = blob(distortedUv, c2, 0.72);
            float orangeA = blob(distortedUv, c3, 0.88);
            float softWhite = blob(distortedUv, c4, 0.95);

            float n = noise(distortedUv * 2.1 + vec2(t * 0.6, -t * 0.45));
            float distort = (n - 0.5) * 0.08;

            float purpleMix = clamp(purpleA * 0.52 + purpleB * 0.36 + distort, 0.0, 1.0);
            float orangeMix = clamp(orangeA * 0.42 + distort * 0.6, 0.0, 1.0);
            float hazeMix = clamp(softWhite * 0.16, 0.0, 0.16);

            vec3 color = mix(uColorBg, uColor1, purpleMix);
            color = mix(color, uColor2, orangeMix);
            color = mix(color, uColor3, hazeMix);

            // Texture: Apply fine film grain
            float grain = (random(uv + t) - 0.5) * 0.05;
            color += grain;

            color = mix(uColorBg, color, 0.88);

            gl_FragColor = vec4(color, 1.0);
          }
        `,
            });

            this.scene.add(
                new THREE.Mesh(new THREE.PlaneGeometry(2, 2), this.material),
            );

            window.addEventListener("mousemove", (e) => {
                this.targetMouse.x = e.clientX / window.innerWidth;
                this.targetMouse.y = 1.0 - e.clientY / window.innerHeight;
            });

            window.addEventListener("resize", () => {
                this.renderer.setSize(window.innerWidth, window.innerHeight);
            });

            this.animate();
        }

        animate() {
            requestAnimationFrame(() => this.animate());
            this.mouse.lerp(this.targetMouse, 0.05);
            this.material.uniforms.uMouse.value = this.mouse;
            this.material.uniforms.uTime.value += 0.01;
            this.renderer.render(this.scene, this.camera);
        }
    }

    const initHeroCanvas = () => {
        const canvas = document.getElementById("liiot-branding-canvas");
        if (canvas instanceof HTMLCanvasElement && !canvas.dataset.loaded) {
            new LiiotBrandingEffect(canvas);
            canvas.dataset.loaded = "true";
        }
    };

    document.addEventListener("astro:page-load", initHeroCanvas);
    if (document.readyState === "complete") {
        initHeroCanvas();
    } else {
        window.addEventListener("load", initHeroCanvas);
    }
</script>

<style>
    canvas {
        filter: blur(6px) saturate(1.03) contrast(1.04);
    }

    /*
     * Fade the *entire* hero canvas layer to transparent near the bottom.
     * This reveals the underlying `main` content background and avoids an abrupt edge.
     */
    .hero-canvas-fade-out {
        -webkit-mask-image: linear-gradient(
            to bottom,
            rgba(0, 0, 0, 1) 0%,
            rgba(0, 0, 0, 1) 62%,
            rgba(0, 0, 0, 0) 100%
        );
        mask-image: linear-gradient(
            to bottom,
            rgba(0, 0, 0, 1) 0%,
            rgba(0, 0, 0, 1) 62%,
            rgba(0, 0, 0, 0) 100%
        );
    }
</style>
