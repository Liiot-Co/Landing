---
/**
 * "Cómo trabajamos" — Tarjetas Apiladas (Sticky Card Stack).
 *
 * Enfoque emocional y juvenil:
 * - Menos texto, copy directo y humano que conecta desde la emoción.
 * - Imágenes juveniles, frescas y espontáneas de equipos creativos / makers.
 * - Colores FLAT vivos del Design System (`var(--primary)`, `var(--accent)`, `var(--brand-pink)`).
 * - Sin texturas ni degradés (superficies sólidas, sin bordes).
 * - Iconos esenciales para destacar los valores clave.
 * - Hover con rotación sutil sin zoom.
 * - Compatible con animación GSAP (`#how-header`).
 */

import {
  HeartHandshake,
  Sparkles,
  Zap,
  Users,
  TrendingUp,
  Sprout,
} from "lucide-astro";
import { unsplashResize, unsplashSrcSet } from "@/lib/images";
import SectionFade from "@/components/ui/SectionFade.astro";
import { IMAGES } from "@/constants/images";
import { t } from "@/i18n";
import { LIIOT_CALENDLY_URL } from "@/constants/contact";

const STEP_IMAGE_WIDTHS = IMAGES.howWeWork.widths;

const ICON_MAP = {
  HeartHandshake,
  Sparkles,
  Zap,
  Users,
  TrendingUp,
  Sprout,
} as const;

const stepImages = [
  IMAGES.howWeWork.step1,
  IMAGES.howWeWork.step2,
  IMAGES.howWeWork.step3,
];

const steps = t.howWeWork.steps.map((step, index) => ({
  ...step,
  image: stepImages[index] ?? "",
  points: step.points.map((pt) => ({
    icon: ICON_MAP[pt.icon as keyof typeof ICON_MAP] ?? Sparkles,
    text: pt.text,
  })),
}));
---

<section id="como-trabajamos" class="relative bg-surface-secondary pt-20 pb-16 sm:py-20 lg:py-28 scroll-mt-24">
  {/* Fade suave superior e inferior para disolver divisiones fijas */}
  <SectionFade position="both" color="background" height="h-28 sm:h-44" zIndex="z-[2]" />

  {/* Fondo interactivo con piezas gigantes del isotipo Liiot en posiciones orgánicas y baja opacidad */}
  <div class="editorial-pieces-bg pointer-events-none absolute inset-0 overflow-hidden select-none" aria-hidden="true">
    {/* Pieza 1: Columna izquierda - Violeta translúcido, grande arriba a la derecha */}
    <div
      class="js-editorial-piece js-morph-piece absolute -right-12 top-8 size-64 sm:size-80 lg:size-[24rem] opacity-[0.09] text-primary transition-opacity duration-500 hover:opacity-25 pointer-events-auto cursor-pointer"
      data-speed="0.04"
      data-rotate="16"
      data-color="#8B45CC"
      style="transform: rotate(16deg);"
    >
      <span class="js-boop block size-full will-change-transform">
      <svg viewBox="0 0 48 48" class="size-full overflow-visible drop-shadow-[0_4px_30px_rgba(90,34,139,0.35)]">
        <path
          d="M23.61,40.54l.03-26.58c0-1.17-1.33-1.84-2.26-1.14-2.77,2.1-5.53,4.2-8.3,6.3-.35.27-.56.68-.56,1.13-.03,8.58-.06,17.16-.09,25.74,0,1.13,1.24,1.81,2.18,1.2,2.79-1.82,5.57-3.64,8.36-5.45.4-.26.64-.71.64-1.19"
          fill="currentColor"
        />
      </svg>
      </span>
    </div>

    {/* Pieza 2: Columna derecha - Naranja cálido translúcido, grande a la izquierda */}
    <div
      class="js-editorial-piece js-morph-piece absolute -left-16 top-[38%] size-72 sm:size-96 lg:size-[28rem] opacity-[0.08] text-accent transition-opacity duration-500 hover:opacity-25 pointer-events-auto cursor-pointer"
      data-speed="-0.035"
      data-rotate="-24"
      data-color="#FF6A33"
      style="transform: rotate(-24deg);"
    >
      <span class="js-boop block size-full will-change-transform">
      <svg viewBox="0 0 48 48" class="size-full overflow-visible drop-shadow-[0_4px_30px_rgba(255,106,51,0.35)]">
        <path
          d="M24.64,7.37l-.03,26.58c0,1.17,1.33,1.84,2.26,1.14,2.77-2.1,5.53-4.2,8.3-6.3.35-.27.56-.68.56-1.13.03-8.58.06-17.16.09-25.74,0-1.13-1.24-1.81-2.18-1.2-2.79,1.82-5.57,3.64-8.36,5.45-.4.26-.64.71-.64,1.19"
          fill="currentColor"
        />
      </svg>
      </span>
    </div>

    {/* Pieza 3: Curva inferior - Magenta translúcido, flotando a la derecha */}
    <div
      class="js-editorial-piece js-morph-piece absolute right-[5%] top-[65%] size-56 sm:size-72 lg:size-88 opacity-[0.08] text-brand-pink transition-opacity duration-500 hover:opacity-25 pointer-events-auto cursor-pointer"
      data-speed="0.045"
      data-rotate="42"
      data-color="#e04b66"
      style="transform: rotate(42deg);"
    >
      <span class="js-boop block size-full will-change-transform">
      <svg viewBox="0 0 48 48" class="size-full overflow-visible drop-shadow-[0_4px_30px_rgba(224,75,102,0.35)]">
        <path
          d="M35.73,41.84c0,2.93-2.41,5.31-5.39,5.31s-5.65-2.49-5.65-5.56v-5.12h5.58c3.02,0,5.47,2.41,5.47,5.38"
          fill="currentColor"
        />
      </svg>
      </span>
    </div>

    {/* Pieza 4: Curva superior - Amarillo translúcido, abajo a la izquierda */}
    <div
      class="js-editorial-piece js-morph-piece absolute left-[12%] bottom-10 size-52 sm:size-64 lg:size-80 opacity-[0.07] text-brand-yellow transition-opacity duration-500 hover:opacity-25 pointer-events-auto cursor-pointer"
      data-speed="-0.04"
      data-rotate="-14"
      data-color="#e2b31c"
      style="transform: rotate(-14deg);"
    >
      <span class="js-boop block size-full will-change-transform">
      <svg viewBox="0 0 48 48" class="size-full overflow-visible drop-shadow-[0_4px_30px_rgba(226,179,28,0.35)]">
        <path
          d="M12.52,6.08c0-2.93,2.41-5.31,5.39-5.31s5.65,2.49,5.65,5.56v5.12h-5.58c-3.02,0-5.47-2.41-5.47-5.38"
          fill="currentColor"
        />
      </svg>
      </span>
    </div>
  </div>

  <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8">
    {/* Encabezado editorial con elemento decorativo de revista en el espacio vacío */}
    <div class="mb-8 flex flex-col justify-between gap-6 sm:flex-row sm:items-end lg:mb-14">
      <div id="how-header" class="max-w-2xl">
        <h2 class="headline-editorial text-4xl text-foreground sm:text-5xl lg:text-6xl">
          {t.howWeWork.titleLine1}<br class="hidden sm:block" />{" "}{t.howWeWork.titleLine2}
        </h2>
        <p class="mt-4 max-w-xl text-base font-medium leading-relaxed text-muted-foreground sm:text-lg">
          {t.howWeWork.subtitle}
        </p>
      </div>

      {/* Pieza decorativa editorial a nivel del headline (sin texto FIG) */}
      <div
        id="editorial-piece-how"
        class="js-boop js-morph-piece hidden sm:flex flex-col items-center justify-end select-none pointer-events-auto cursor-pointer pb-2"
        aria-hidden="true"
        data-color="#8B45CC"
      >
        <div class="relative size-20 sm:size-24 lg:size-28 opacity-75 text-primary transition-transform duration-500 will-change-transform">
          <svg viewBox="0 0 48 48" class="size-full overflow-visible drop-shadow-[0_2px_16px_rgba(90,34,139,0.25)]">
            <path
              d="M23.61,40.54l.03-26.58c0-1.17-1.33-1.84-2.26-1.14-2.77,2.1-5.53,4.2-8.3,6.3-.35.27-.56.68-.56,1.13-.03,8.58-.06,17.16-.09,25.74,0,1.13,1.24,1.81,2.18,1.2,2.79-1.82,5.57-3.64,8.36-5.45.4-.26.64-.71.64-1.19"
              fill="currentColor"
            />
          </svg>
        </div>
      </div>
    </div>

    {/* Contenedor de Tarjetas Apiladas (Sticky Stack) */}
    <div class="how-cards-stack relative flex flex-col gap-6 pb-6 sm:gap-10 sm:pb-12 lg:gap-14 lg:pb-20">
      {
        steps.map((step, index) => {
          const isDarkText = step.textColor === "dark";
          return (
            <article
              class={`how-card how-card--${step.theme} squircle group relative w-full overflow-hidden p-6 transition-all duration-300 sm:p-9 lg:p-12 ${isDarkText ? "text-[#07040F]" : "text-white"}`}
              style={`--stack-index: ${index}; --hover-rotation: ${step.rotation};`}
              data-step-card={index + 1}
            >
              {/* Contenido Editorial con retícula equilibrada */}
              <div class="relative z-10 grid grid-cols-1 items-center gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:gap-12">
                {/* Columna Izquierda: Información emocional y concisa */}
                <div class="flex flex-col justify-center">
                  {/* Titular limpio sin números */}
                  <h3 class={`text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl ${isDarkText ? "text-[#07040F]" : "text-white"}`}>
                    {step.title}
                  </h3>

                  {/* Frase emocional protagonista */}
                  <p class={`mt-4 text-base font-medium leading-relaxed sm:text-lg lg:text-xl ${isDarkText ? "text-[#07040F]/90" : "text-white/95"}`}>
                    {step.emotion}
                  </p>

                  {/* Puntos clave emocionales con iconos */}
                  <div class="mt-6 flex flex-col gap-3 sm:mt-7">
                    {step.points.map((pt) => {
                      const IconComponent = pt.icon;
                      return (
                        <div class="flex items-center gap-3">
                          <div class={`flex size-7 flex-shrink-0 items-center justify-center rounded-lg ${isDarkText ? "bg-[#07040F]/12 text-[#07040F]" : "bg-white/20 text-white"}`}>
                            <IconComponent class="size-3.5" />
                          </div>
                          <span class={`text-sm font-semibold tracking-tight sm:text-base ${isDarkText ? "text-[#07040F]/90" : "text-white/90"}`}>
                            {pt.text}
                          </span>
                        </div>
                      );
                    })}
                  </div>
                </div>

                {/* Columna Derecha: Imagen juvenil con efecto Chroma Pop en hover (cero zoom/translate) */}
                <div class="relative w-full">
                  <div class="media-frame squircle relative aspect-[16/10] w-full overflow-hidden sm:aspect-[16/11] lg:aspect-[4/3]">
                    <div class="chroma-media h-full w-full">
                      <img
                        src={unsplashResize(step.image, 800, 70)}
                        srcset={unsplashSrcSet(step.image, STEP_IMAGE_WIDTHS, 70)}
                        sizes="(min-width: 1024px) 500px, 90vw"
                        alt={`Liiot · ${step.title}`}
                        class="how-card-img h-full w-full object-cover"
                        loading="lazy"
                      />
                      <div class="chroma-veil" aria-hidden="true"></div>
                      <div class="chroma-sheen" aria-hidden="true"></div>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    {/* CTA intermedio: el lector ya vio el método y todavía no ha visto un botón */}
    <div class="flex flex-col items-center gap-6 text-center">
      <p class="max-w-xl text-xl font-bold tracking-tight text-foreground sm:text-2xl">
        {t.howWeWork.cta.text}
      </p>
      <a
        href={LIIOT_CALENDLY_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-editorial btn-editorial--violet inline-flex items-center justify-center px-8 py-4 text-sm uppercase tracking-[0.1em]"
      >
        {t.howWeWork.cta.button}
      </a>
    </div>
  </div>
</section>

<style>
  /* ════════════════════════════════════════════════════════════════════
     STACKING CARDS (STICKY APILADO)
     ════════════════════════════════════════════════════════════════════ */
  .how-cards-stack {
    position: relative;
  }

  .how-card {
    position: sticky;
    top: calc(5.5rem + var(--stack-index) * 1.5rem);
    z-index: calc(10 + var(--stack-index));
    border: none;
    border-radius: 44px;
    corner-smoothing: 60%;
    -webkit-corner-smoothing: 60%;
    box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.65), 0 2px 6px rgba(0, 0, 0, 0.25);
  }

  @media (min-width: 640px) {
    .how-card {
      top: calc(6.5rem + var(--stack-index) * 2rem);
    }
  }

  @media (min-width: 1024px) {
    .how-card {
      top: calc(7rem + var(--stack-index) * 2.25rem);
    }
  }

  /* ════════════════════════════════════════════════════════════════════
     COLORES FLAT VIVOS (VARIABLES DEL DESIGN SYSTEM)
     ════════════════════════════════════════════════════════════════════ */
  .how-card--violet {
    background-color: var(--primary);
  }

  .how-card--orange {
    background-color: var(--accent);
  }

  .how-card--pink {
    background-color: var(--brand-pink);
  }

  /* ════════════════════════════════════════════════════════════════════
     HOVER DE IMAGEN: CHROMA POP & NEON GLOW (CERO ZOOM / CERO TRANSLATE)
     ════════════════════════════════════════════════════════════════════ */
  .media-frame {
    border-radius: 26px;
    corner-smoothing: 60%;
    -webkit-corner-smoothing: 60%;
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 14px 32px -8px rgba(0, 0, 0, 0.45);
    transition: box-shadow 450ms cubic-bezier(0.4, 0, 0.2, 1), border-color 450ms ease;
  }

  .chroma-media {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .how-card-img {
    filter: grayscale(0.55) contrast(1.1) brightness(0.88);
    transition: filter 450ms cubic-bezier(0.4, 0, 0.2, 1);
    transform: none !important;
  }

  /* Velo de color base */
  .chroma-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      140deg,
      rgba(90, 34, 139, 0.35) 0%,
      transparent 55%,
      rgba(255, 106, 51, 0.3) 100%
    );
    mix-blend-mode: color;
    opacity: 0.85;
    transition: opacity 450ms ease;
    pointer-events: none;
  }

  /* Destello holográfico y color Pop en hover */
  .chroma-sheen {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 75% 25%,
      rgba(255, 77, 109, 0.45) 0%,
      rgba(255, 195, 0, 0.3) 40%,
      transparent 75%
    );
    mix-blend-mode: screen;
    opacity: 0;
    transition: opacity 450ms cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  /* ── ESTADOS AL HACER HOVER EN LA TARJETA ── */
  .how-card:hover .how-card-img,
  .how-card:focus-within .how-card-img {
    filter: grayscale(0) saturate(1.5) contrast(1.18) brightness(1.04);
  }

  .how-card:hover .chroma-veil,
  .how-card:focus-within .chroma-veil {
    opacity: 0.2;
  }

  .how-card:hover .chroma-sheen,
  .how-card:focus-within .chroma-sheen {
    opacity: 1;
  }

  /* Resplandores Neón vivos por tema de tarjeta */
  .how-card--violet:hover .media-frame {
    border-color: rgba(255, 255, 255, 0.45);
    box-shadow:
      0 0 36px -4px rgba(255, 77, 109, 0.7),
      0 0 16px rgba(139, 69, 204, 0.55),
      0 16px 36px -8px rgba(0, 0, 0, 0.6);
  }

  .how-card--orange:hover .media-frame {
    border-color: rgba(255, 255, 255, 0.5);
    box-shadow:
      0 0 36px -4px rgba(255, 195, 0, 0.75),
      0 0 16px rgba(255, 106, 51, 0.65),
      0 16px 36px -8px rgba(0, 0, 0, 0.5);
  }

  .how-card--pink:hover .media-frame {
    border-color: rgba(255, 255, 255, 0.5);
    box-shadow:
      0 0 36px -4px rgba(255, 106, 51, 0.75),
      0 0 16px rgba(255, 77, 109, 0.65),
      0 16px 36px -8px rgba(0, 0, 0, 0.5);
  }

  /* Prefers reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .how-card {
      position: static;
      box-shadow: none;
    }
    .how-card-img {
      transition: none;
      transform: none !important;
    }
  }

  /* Perf: suspend card hover while actively scrolling (`html.is-scrolling`,
     toggled from landing-motion.ts) so transitions don't recompute mid-scroll;
     resumes 150ms after scrolling stops. */
  html.is-scrolling .how-card {
    pointer-events: none;
  }

  html.is-scrolling .how-card-img,
  html.is-scrolling .media-frame,
  html.is-scrolling .chroma-veil,
  html.is-scrolling .chroma-sheen {
    transition: none !important;
  }

  /* ════════════════════════════════════════════════════════════════════
     EDITORIAL PIECES: STATIC TRANSFORM + ONE-SHOT CSS REVEAL
     Replaces the previous pointer-tracked ("magnetic") rAF parallax, which
     kept running every frame even off-screen. The transform stays exactly
     as set inline (static); only opacity transitions, once, staggered per
     piece, the first time the section enters the viewport.
     ════════════════════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: no-preference) {
    .js-editorial-piece {
      transition: opacity 900ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .editorial-pieces-bg:not(.is-revealed) .js-editorial-piece {
      opacity: 0 !important;
      transition: none;
    }

    .editorial-pieces-bg.is-revealed .js-editorial-piece:nth-of-type(1) {
      transition-delay: 0ms;
    }
    .editorial-pieces-bg.is-revealed .js-editorial-piece:nth-of-type(2) {
      transition-delay: 90ms;
    }
    .editorial-pieces-bg.is-revealed .js-editorial-piece:nth-of-type(3) {
      transition-delay: 180ms;
    }
    .editorial-pieces-bg.is-revealed .js-editorial-piece:nth-of-type(4) {
      transition-delay: 270ms;
    }
  }
</style>

<script>
  /**
   * Micro-interacción de profundidad al hacer scroll:
   * Atenúa suavemente la escala de la tarjeta que queda debajo.
   */
  function initCardStackMotion() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const cards = document.querySelectorAll<HTMLElement>(".how-card");
    if (cards.length < 2) return;

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        cards.forEach((card, i) => {
          if (i === cards.length - 1) return;
          const nextCard = cards[i + 1];
          if (!nextCard) return;

          const cardRect = card.getBoundingClientRect();
          const nextRect = nextCard.getBoundingClientRect();

          if (nextRect.top <= cardRect.bottom && nextRect.top > cardRect.top) {
            const overlap = (cardRect.bottom - nextRect.top) / cardRect.height;
            const clamped = Math.min(Math.max(overlap, 0), 1);
            const scale = 1 - clamped * 0.04;
            const brightness = 1 - clamped * 0.12;
            card.style.transform = `scale(${scale})`;
            card.style.filter = `brightness(${brightness})`;
          } else if (nextRect.top <= cardRect.top) {
            card.style.transform = "scale(0.96)";
            card.style.filter = "brightness(0.88)";
          } else {
            card.style.transform = "scale(1)";
            card.style.filter = "brightness(1)";
          }
        });
        ticking = false;
      });
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  /**
   * One-shot reveal for the decorative background pieces: replaces the
   * previous pointer-tracked ("magnetic") rAF parallax, which kept
   * recalculating every frame regardless of scroll position or visibility.
   * The pieces keep their static inline rotation; only a staggered CSS
   * opacity transition (see `.editorial-pieces-bg.is-revealed` above) fires
   * once, the first time the section enters the viewport.
   */
  function initEditorialPiecesReveal() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const section = document.getElementById("como-trabajamos");
    const bg = section?.querySelector<HTMLElement>(".editorial-pieces-bg");
    if (!bg) return;

    const observer = new IntersectionObserver(
      (entries, obs) => {
        if (entries[0]?.isIntersecting) {
          bg.classList.add("is-revealed");
          obs.disconnect();
        }
      },
      { threshold: 0.1 }
    );
    observer.observe(bg);
  }

  function initHowMotion() {
    initCardStackMotion();
    initEditorialPiecesReveal();
  }

  if (document.readyState === "complete" || document.readyState === "interactive") {
    initHowMotion();
  } else {
    document.addEventListener("DOMContentLoaded", initHowMotion);
  }
  document.addEventListener("astro:page-load", initHowMotion);
</script>
