---
/**
 * Brand statement — Cinematic focus pull and sequential word reveal.
 */
import { SCROLL_QUOTE_TEXT } from "@/lib/scroll-quote";

// We split the quote server-side to animate each word individually
const words = SCROLL_QUOTE_TEXT.split(" ");
---

<section
  id="philosophy-statement"
  class="relative flex min-h-[50vh] items-center justify-center overflow-hidden py-24 lg:py-32"
>
  <div
    class="pointer-events-none absolute inset-0 z-0 flex items-center justify-center"
    aria-hidden="true"
  >
    <div
      id="phil-glow"
      class="h-[40vw] w-[40vw] max-w-[600px] rounded-full bg-primary/20 blur-[120px] opacity-0 scale-50 transition-all duration-1000 ease-[cubic-bezier(0.22,1,0.36,1)]"
    >
    </div>
  </div>

  <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <p
        id="phil-eyebrow"
        class="section-eyebrow mb-8 text-primary font-bold tracking-[0.2em] uppercase text-xs opacity-0"
      >
        Nuestra filosofía
      </p>

      <h2
        id="phil-quote"
        class="text-3xl font-extrabold leading-[1.3] text-foreground sm:text-4xl lg:text-5xl"
      >
        {
          words.map((word) => (
            <span class="js-phil-word inline-block opacity-0 blur-[12px] translate-y-8 scale-95 mr-[0.25em] will-change-[transform,filter,opacity]">
              {word}
            </span>
          ))
        }
      </h2>

      <div class="mx-auto mt-12 flex justify-center">
        <div
          id="phil-divider"
          class="h-[2px] w-0 bg-gradient-to-r from-transparent via-accent to-transparent opacity-0"
          aria-hidden="true"
        >
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Ensure Safari handles the blur animations smoothly */
  .js-phil-word {
    -webkit-font-smoothing: antialiased;
  }
</style>
