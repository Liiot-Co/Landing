---
/**
 * "El Villano" — el obstáculo que el visitante ya conoce (viaje del héroe,
 * etapa 3). Da voz a la fricción antes de presentar a Liiot como guía.
 * Copy basado en vault §1 "Qué no es Liiot".
 */
const obstacles = [
  "Agencias que venden horas, no compromiso.",
  "Código que nadie entiende — ni quien lo escribió.",
  "Un producto que nunca se siente realmente tuyo.",
];
---

<section id="el-reto" class="relative overflow-hidden bg-background py-24 lg:py-32">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div id="villain-header" class="max-w-3xl translate-y-6 opacity-0">
      <h2 class="headline-editorial text-4xl text-foreground sm:text-5xl lg:text-6xl">
        No somos una<br /><span class="text-brand-pink">fábrica de código</span>
      </h2>
    </div>

    <ul class="mt-16 grid grid-cols-1 gap-x-8 gap-y-10 border-t border-border pt-12 sm:grid-cols-3 lg:mt-20 lg:pt-14">
      {
        obstacles.map((text, i) => (
          <li class="js-villain-item translate-y-6 opacity-0">
            <span class="mb-4 block text-sm font-bold tabular-nums text-brand-pink/70">
              0{i + 1}
            </span>
            <p class="max-w-xs text-lg font-bold leading-snug text-foreground/85 sm:text-xl">
              {text}
            </p>
          </li>
        ))
      }
    </ul>

    <p
      id="villain-pivot"
      class="mt-16 translate-y-6 text-xl font-bold text-muted-foreground opacity-0 sm:text-2xl lg:mt-20"
    >
      No tiene que ser así.
    </p>
  </div>
</section>
