---
/**
 * "¿Listo para construir con propósito?" — el héroe vuelve con el elixir
 * (viaje del héroe, etapa 5): la transformación ya es posible, solo falta
 * dar el paso. Fondo naranja sólido (Brandbook tonalGradient.orange —
 * "CTAs grandes, banners de sección Humanidad") + morph gradient "human"
 * en textura, rompe el negro dominante del resto del sitio.
 * Fuente: vault §7.
 */
import MorphGradient from "@/components/ui/MorphGradient.astro";
import { LIIOT_CALENDLY_URL } from "@/constants/contact";
---

<section
  id="agendar"
  class="relative flex min-h-[80vh] items-center overflow-hidden py-28"
  style="background: linear-gradient(160deg, #B84A22 0%, #FF6A33 45%, #FF8A5C 100%);"
>
  <MorphGradient recipe="human" blend="soft-light" opacity={0.5} />

  <div class="container relative z-10 mx-auto px-4 text-center sm:px-6 lg:px-8">
    <div id="final-cta-card" class="mx-auto max-w-3xl">
      {/* Isotipo completo ensamblado como clímax final del viaje */}
      <div id="final-logo-target" class="mx-auto mb-8 flex justify-center items-center">
        <div class="final-logo-badge relative size-16 sm:size-20 transition-transform duration-500 hover:scale-110">
          <svg viewBox="0 0 48 48" class="h-full w-full overflow-visible" aria-hidden="true">
            {/* Pieza 1: Columna izquierda */}
            <path
              d="M23.61,40.54l.03-26.58c0-1.17-1.33-1.84-2.26-1.14-2.77,2.1-5.53,4.2-8.3,6.3-.35.27-.56.68-.56,1.13-.03,8.58-.06,17.16-.09,25.74,0,1.13,1.24,1.81,2.18,1.2,2.79-1.82,5.57-3.64,8.36-5.45.4-.26.64-.71.64-1.19"
              fill="#FFFFFF"
              class="final-logo-piece"
            />
            {/* Pieza 2: Columna derecha */}
            <path
              d="M24.64,7.37l-.03,26.58c0,1.17,1.33,1.84,2.26,1.14,2.77-2.1,5.53-4.2,8.3-6.3.35-.27.56-.68.56-1.13.03-8.58.06-17.16.09-25.74,0-1.13-1.24-1.81-2.18-1.2-2.79,1.82-5.57,3.64-8.36,5.45-.4.26-.64.71-.64,1.19"
              fill="#FFFFFF"
              class="final-logo-piece"
            />
            {/* Pieza 3: Curva inferior */}
            <path
              d="M35.73,41.84c0,2.93-2.41,5.31-5.39,5.31s-5.65-2.49-5.65-5.56v-5.12h5.58c3.02,0,5.47,2.41,5.47,5.38"
              fill="#FFFFFF"
              class="final-logo-piece"
            />
            {/* Pieza 4: Curva superior */}
            <path
              d="M12.52,6.08c0-2.93,2.41-5.31,5.39-5.31s5.65,2.49,5.65,5.56v5.12h-5.58c-3.02,0-5.47-2.41-5.47-5.38"
              fill="#FFFFFF"
              class="final-logo-piece"
            />
          </svg>
        </div>
      </div>

      <h2 class="headline-editorial text-4xl text-[#07040F] sm:text-6xl lg:text-7xl">
        <span>Crezcamos</span> juntos
      </h2>

      <p class="mx-auto mt-9 max-w-lg text-base font-semibold leading-relaxed text-[#07040F]/80 sm:text-lg">
        Cuéntanos qué necesitas, lo construimos juntos.
      </p>

      <div class="mt-12">
        <a
          href={LIIOT_CALENDLY_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-physical btn-physical--dark inline-flex items-center gap-3 rounded-xl px-10 py-5 text-sm uppercase tracking-[0.1em]"
        >
          Agendar consultoría
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .final-logo-piece {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.4s ease;
  }

  .final-logo-badge {
    filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.3));
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.6s ease;
  }

  :global(#final-logo-target.is-converged) .final-logo-badge {
    filter: drop-shadow(0 0 28px rgba(255, 255, 255, 0.8)) drop-shadow(0 12px 28px rgba(0, 0, 0, 0.4));
    transform: scale(1.06);
  }

  .final-logo-badge:hover {
    filter: drop-shadow(0 0 32px rgba(255, 255, 255, 0.9)) drop-shadow(0 14px 30px rgba(0, 0, 0, 0.45));
    transform: scale(1.12);
  }

  @media (prefers-reduced-motion: reduce) {
    .final-logo-badge {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
