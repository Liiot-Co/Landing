---
// Importaciones de iconos de Lucide-Astro
import { ArrowRight, CheckCircle2 } from 'lucide-astro';
// Asumimos que tienes el componente Button.astro en la misma carpeta.
import Button from '@/components/ui/button.astro'; 

const CTA_ID = "final-cta";
const CONTAINER_ID = "cta-container";
const CONTENT_ID = "cta-content";
const BUTTON_ID = "cta-button";
const BENEFIT_CLASS = ".cta-benefit-item";

const benefits = [
  "See how it works for your team",
  "Personalized walkthrough",
  "No commitment required",
];
---

<section id={CTA_ID} class="py-24 lg:py-32 relative overflow-hidden">
  
  {/* GeometricAccent Replacement (Simulado con SVG para evitar dependencias externas) */}
  <div class="absolute top-0 left-0 text-secondary/5 pointer-events-none w-full h-1/4">
     <svg width="100%" height="100%" viewBox="0 0 100 20" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
       <rect x="0" y="0" width="100" height="10" fill="currentColor" fill-opacity="0.5" />
       <rect x="0" y="10" width="100" height="10" fill="currentColor" fill-opacity="0.2" />
     </svg>
  </div>
  
  {/* Background effects with gradient blend */}
  <div class="absolute inset-0 bg-linear-to-br from-secondary/8 via-transparent to-primary/5 pointer-events-none" />
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-radial from-secondary/8 to-transparent rounded-full blur-[100px] pointer-events-none" />

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    {/* OUTER CONTAINER - Animación principal de entrada (initial: { opacity: 0, y: 15 }) */}
    <div
      id={CONTAINER_ID}
      class="max-w-4xl mx-auto opacity-0 translate-y-4"
    >
      <div class="bg-card/50 backdrop-blur-sm border border-secondary/20 rounded-3xl p-12 lg:p-16 text-center">
        
        {/* INNER CONTENT (H2, P) - Animación con delay 0.1s */}
        <div id={CONTENT_ID} class="opacity-0">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6">
            Ready to <span class="text-gradient">transform</span> your workflow?
          </h2>
          <p class="text-lg text-muted-foreground mb-10 max-w-2xl mx-auto">
            Discover how our platform can optimize your team's workflow and boost productivity.
          </p>

          {/* Benefits with secondary accent - Animación escalonada (stagger) con delay 0.2s */}
          <div class="flex flex-wrap justify-center gap-6 mb-10">
            {benefits.map((benefit) => (
              <div
                class={BENEFIT_CLASS.substring(1) + " flex items-center space-x-2 opacity-0"}
              >
                <CheckCircle2 class="w-5 h-5 text-secondary flex-shrink-0" />
                <span class="text-sm text-muted-foreground">{benefit}</span>
              </div>
            ))}
          </div>
        </div>

        {/* CTA Button - Animación con delay 0.3s */}
        <div
          id={BUTTON_ID}
          class="flex flex-col sm:flex-row items-center justify-center gap-4 opacity-0"
        >
          <Button
            size="lg"
            class="bg-linear-to-r from-secondary to-secondary/70 text-secondary-foreground hover:from-secondary/90 hover:to-secondary/60 group px-14 py-8 text-xl font-semibold shadow-xl shadow-secondary/30 rounded-xl"
          >
            Request Demo
            <ArrowRight class="ml-3 h-6 w-6 transition-transform group-hover:translate-x-1" />
          </Button>
        </div>

        <p class="text-sm text-muted-foreground mt-8">
          Questions? Contact us at{" "}
          <a href="mailto:hello@softwareco.com" class="text-secondary hover:underline">
            hello@softwareco.com
          </a>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
    import { animate, inView, stagger, type StaggerOrigin } from "motion";

    // Selectores definidos en el frontmatter
    const CTA_ID = "#final-cta";
    const CONTAINER_ID = "#cta-container";
    const CONTENT_ID = "#cta-content";
    const BUTTON_ID = "#cta-button";
    const BENEFIT_CLASS = ".cta-benefit-item";

    // Estado Final: opacidad 1 y transformación reseteada
    const finalState = { opacity: 1, transform: "none" };
    const fixedOpacity = { opacity: 1 };

    // Opciones de animación base
    const opts = { duration: 0.5, easing: "ease-out" };

    // Disparador de la animación al entrar en la vista
    inView(CTA_ID, (element) => {
        
        // 1. Outer Container (Animación principal, duration 0.5s, delay 0.0s)
        animate(CONTAINER_ID, finalState, opts);

        // 2. Content (H2, P) (duration 0.5s, delay 0.1s)
        animate(CONTENT_ID, fixedOpacity, { ...opts, delay: 0.1 });

        // 3. Benefits (Stagger, duration 0.4s, start delay 0.2s)
        const benefitItems = element.querySelectorAll(BENEFIT_CLASS);
        animate(benefitItems, fixedOpacity, { 
            duration: 0.4, 
            delay: stagger(0.05, { from: "start" as StaggerOrigin }) 
        });

        // 4. Button (duration 0.5s, delay 0.3s)
        animate(BUTTON_ID, fixedOpacity, { ...opts, delay: 0.3 });

    }, { margin: "-100px 0px 0px 0px" });
</script>

<style>
  /* Utilidad para texto con gradiente si no está definida globalmente */
  .text-gradient {
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-image: linear-gradient(to right, hsl(var(--primary)) 20%, hsl(var(--secondary)));
  }
</style>