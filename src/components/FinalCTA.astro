---
import { HEDUL_WHATSAPP_URL } from "@/constants/contact";
import SectionAmbience from "@/components/ui/SectionAmbience.astro";
import FinalCTAButton from "@/components/FinalCTAButton.astro";
import SurfaceCard from "@/components/ui/SurfaceCard.astro";
---

<section id="cta" class="relative overflow-hidden py-16 lg:py-24">
  <SectionAmbience class="opacity-50" />

  <div
    class="pointer-events-none absolute inset-0 bg-linear-to-br from-primary/5 via-transparent to-accent/6"
    aria-hidden="true"
  ></div>

  <div class="container relative z-10 mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <SurfaceCard
        id="final-cta-card"
        class="p-10 text-center opacity-0 translate-y-6 lg:p-14"
        tone="dark"
      >
        <p class="section-eyebrow mb-4 text-accent">Pedí tu demo</p>

        <h2 class="mb-5 text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl">
          ¿Listo para <span class="text-gradient">operar con claridad</span>?
        </h2>

        <p class="mx-auto mb-8 max-w-lg text-base font-medium leading-relaxed text-white/75">
          Coordinamos una demo breve por WhatsApp.
        </p>

        <div class="relative mx-auto inline-block">
          <FinalCTAButton
            href={HEDUL_WHATSAPP_URL}
            size="section"
            target="_blank"
            class="relative z-10 shadow-[0_14px_30px_-18px_color-mix(in_oklab,var(--color-primary)_70%,transparent)]"
          >
            Solicitar demo en WhatsApp
          </FinalCTAButton>
        </div>
      </SurfaceCard>
    </div>
  </div>
</section>
