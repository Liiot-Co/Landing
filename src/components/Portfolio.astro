---
/**
 * "Qué hicimos" — Carousel Minimalista de Proyectos.
 *
 * Muestra:
 * - Liiot Custom (con SG-SST integrado como caso real de desarrollo a medida).
 * - Bleepy (plataforma de creadores y empresas · Coming soon).
 *
 * Directrices:
 * - Sin texturas, sin degradés y sin números.
 * - Sin pills ni badges.
 * - Colores FLAT vivos del Design System.
 * - Sin box-shadow en los botones (botones planos y limpios).
 * - Máxima síntesis y alto impacto emocional.
 * - Compatible con GSAP ScrollTrigger (`#portfolio-header`, `.js-portfolio-item`).
 */

import { PORTFOLIO_PROJECTS } from "@/constants/portfolio";
import { ArrowLeft, ArrowRight, ArrowUpRight } from "lucide-astro";
---

<section id="proyectos" class="relative overflow-hidden bg-background py-24 lg:py-32">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    {/* Encabezado: "Qué hicimos" (sin eyebrows) */}
    <div class="mb-10 flex flex-col justify-between gap-6 md:flex-row md:items-end lg:mb-14">
      <div id="portfolio-header" class="flex items-start gap-4 sm:gap-6 max-w-xl translate-y-6 opacity-0">
        {/* Eyebrow vertical lateral (de arriba hacia abajo) */}
        <div class="flex flex-col items-center pt-2 select-none flex-shrink-0" aria-hidden="true">
          <span class="size-2 rounded-full bg-accent mb-3"></span>
          <span class="section-eyebrow-vertical">
            Proyectos
          </span>
          <span class="w-[1px] h-10 bg-gradient-to-b from-border to-transparent mt-3"></span>
        </div>

        <div>
          <h2 class="headline-editorial text-4xl text-foreground sm:text-5xl lg:text-6xl">
            Qué hicimos
          </h2>
          <p class="mt-3 text-base font-medium leading-relaxed text-muted-foreground sm:text-lg">
            Software a medida que cuida personas y plataformas que crean comunidad real.
          </p>
        </div>
      </div>

      {/* Flechas de Navegación (planas, sin box-shadow ni bordes) */}
      <div class="flex items-center gap-2.5">
        <button
          type="button"
          id="carousel-prev"
          class="carousel-nav-btn flex size-11 items-center justify-center rounded-full bg-surface-secondary text-white transition-colors duration-150 hover:bg-white/20 active:scale-95 disabled:opacity-25 disabled:pointer-events-none"
          aria-label="Proyecto anterior"
        >
          <ArrowLeft class="size-5" />
        </button>
        <button
          type="button"
          id="carousel-next"
          class="carousel-nav-btn flex size-11 items-center justify-center rounded-full bg-surface-secondary text-white transition-colors duration-150 hover:bg-white/20 active:scale-95 disabled:opacity-25 disabled:pointer-events-none"
          aria-label="Siguiente proyecto"
        >
          <ArrowRight class="size-5" />
        </button>
      </div>
    </div>
  </div>

  {/* Pista del Carousel (Snap horizontal) */}
  <div class="carousel-viewport relative w-full overflow-hidden px-4 sm:px-6 lg:px-8">
    <div
      id="portfolio-track"
      class="carousel-track flex snap-x snap-mandatory gap-6 overflow-x-auto pb-4 pt-1 scrollbar-none sm:gap-8 lg:gap-10"
      tabindex="0"
      role="region"
      aria-label="Carrusel Qué hicimos"
    >
      {
        PORTFOLIO_PROJECTS.map((project, index) => (
          <article
            class={`js-portfolio-item project-card project-card--${project.themeColor} squircle group relative w-[90vw] flex-shrink-0 snap-center overflow-hidden p-7 transition-all duration-300 sm:w-[84vw] sm:p-10 md:w-[78vw] lg:w-[72vw] xl:w-[1100px] lg:p-14 text-white`}
            data-index={index}
          >
            {/* Grid 2 Columnas: Contenido Emocional & Fotografía */}
            <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
              {/* Columna Izquierda: Información sintetizada */}
              <div class="flex flex-col justify-center">
                {/* Subtítulo limpio en texto (sin pill) */}
                <span class="text-xs font-bold tracking-wider uppercase text-white/75 sm:text-sm">
                  {project.subtitle}
                </span>

                {/* Gran Titular */}
                <h3 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl lg:text-5xl">
                  {project.title}
                </h3>

                {/* Frase Emocional Protagonista */}
                <p class="mt-5 text-base font-medium leading-relaxed text-white/95 sm:text-lg lg:text-xl">
                  {project.description}
                </p>

                {/* Botón de Acción (Flat, sin box-shadow) */}
                <div class="mt-8 flex items-center">
                  <a
                    href={project.ctaLink}
                    class="project-btn inline-flex items-center gap-2.5 rounded-xl bg-white px-7 py-3.5 text-xs font-bold tracking-wider text-black uppercase transition-transform duration-150 hover:bg-white/95 active:scale-95 sm:text-sm"
                  >
                    <span>{project.ctaText}</span>
                    <ArrowUpRight class="size-4" />
                  </a>
                </div>
              </div>

              {/* Columna Derecha: Imagen Fotográfica con Chroma Pop (sin zoom) */}
              <div class="relative w-full">
                <div class="media-frame squircle relative aspect-[16/11] w-full overflow-hidden lg:aspect-[4/3]">
                  <div class="chroma-media h-full w-full">
                    <img
                      src={project.image}
                      alt={project.imageAlt}
                      class="project-card-img h-full w-full object-cover"
                      loading="lazy"
                      draggable="false"
                    />
                    <div class="chroma-veil" aria-hidden="true"></div>
                    <div class="chroma-sheen" aria-hidden="true"></div>
                  </div>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  {/* Indicadores de Slide Minimalistas */}
  <div class="container mx-auto mt-6 px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-center gap-2">
      {
        PORTFOLIO_PROJECTS.map((_, i) => (
          <button
            type="button"
            class="carousel-indicator h-1.5 rounded-full transition-all duration-300"
            data-target-index={i}
            aria-label={`Ir al slide ${i + 1}`}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ════════════════════════════════════════════════════════════════════
     CAROUSEL TRACK & SCROLL
     ════════════════════════════════════════════════════════════════════ */
  .carousel-track {
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
  }

  /* While dragging (mouse only — see script): instant tracking, no text selection */
  .carousel-track.is-dragging {
    scroll-behavior: auto;
    cursor: grabbing;
    user-select: none;
  }

  .carousel-track .project-btn {
    cursor: pointer;
  }

  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* ════════════════════════════════════════════════════════════════════
     COLORES VIVOS FLAT (SIN DEGRADÉS, SIN TEXTURAS, SIN BORDES)
     ════════════════════════════════════════════════════════════════════ */
  .project-card {
    border: none;
    border-radius: 44px;
    corner-smoothing: 60%;
    -webkit-corner-smoothing: 60%;
    will-change: clip-path, transform;
  }

  .media-frame {
    border-radius: 28px;
    corner-smoothing: 60%;
    -webkit-corner-smoothing: 60%;
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.45);
    transition: box-shadow 450ms cubic-bezier(0.4, 0, 0.2, 1), border-color 450ms ease;
  }

  .chroma-media {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .project-card-img {
    filter: grayscale(0.6) contrast(1.1) brightness(0.9);
    transition: filter 450ms cubic-bezier(0.4, 0, 0.2, 1);
    transform: none !important;
  }

  .chroma-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      150deg,
      rgba(90, 34, 139, 0.4) 0%,
      transparent 55%,
      rgba(255, 106, 51, 0.35) 100%
    );
    mix-blend-mode: color;
    opacity: 0.85;
    transition: opacity 450ms ease;
    pointer-events: none;
  }

  .chroma-sheen {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 75% 25%,
      rgba(255, 195, 0, 0.45) 0%,
      rgba(255, 77, 109, 0.35) 45%,
      transparent 75%
    );
    mix-blend-mode: screen;
    opacity: 0;
    transition: opacity 450ms cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  /* ── HOVER CHROMA POP & NEON GLOW ── */
  .project-card:hover .project-card-img {
    filter: grayscale(0) saturate(1.5) contrast(1.18) brightness(1.05);
  }

  .project-card:hover .chroma-veil {
    opacity: 0.18;
  }

  .project-card:hover .chroma-sheen {
    opacity: 1;
  }

  /* ── LIIOT CUSTOM: VIOLETA VIVO CON NEON RIM ── */
  .project-card--violet {
    background-color: var(--primary);
  }

  .project-card--violet:hover .media-frame {
    border-color: rgba(255, 255, 255, 0.5);
    box-shadow:
      0 0 38px -4px rgba(255, 106, 51, 0.75),
      0 0 16px rgba(139, 69, 204, 0.6),
      0 16px 36px -8px rgba(0, 0, 0, 0.6);
  }

  /* ── BLEEPY: ROSA VIVO CON NEON RIM ── */
  .project-card--pink {
    background-color: var(--brand-pink);
  }

  .project-card--pink:hover .media-frame {
    border-color: rgba(255, 255, 255, 0.5);
    box-shadow:
      0 0 38px -4px rgba(255, 195, 0, 0.8),
      0 0 16px rgba(255, 77, 109, 0.65),
      0 16px 36px -8px rgba(0, 0, 0, 0.6);
  }

  /* ════════════════════════════════════════════════════════════════════
     BOTONES PLANOS: CERO BOX SHADOW
     ════════════════════════════════════════════════════════════════════ */
  .project-btn {
    box-shadow: none !important;
    border: none !important;
  }

  .carousel-nav-btn {
    box-shadow: none !important;
    border: none !important;
  }

  /* ════════════════════════════════════════════════════════════════════
     INDICADORES
     ════════════════════════════════════════════════════════════════════ */
  .carousel-indicator {
    width: 24px;
    background-color: rgba(255, 255, 255, 0.2);
    border: none;
    box-shadow: none !important;
  }
  .carousel-indicator.is-active {
    width: 52px;
    background-color: var(--accent);
  }
</style>

<script>
  function initPortfolio() {
    initPortfolioCarousel();
  }

  function initPortfolioCarousel() {
    const track = document.getElementById("portfolio-track");
    const prevBtn = document.getElementById("carousel-prev") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("carousel-next") as HTMLButtonElement | null;
    const indicators = document.querySelectorAll<HTMLElement>(".carousel-indicator");

    if (!track) return;

    const cards = Array.from(track.querySelectorAll<HTMLElement>(".project-card"));
    if (cards.length === 0) return;

    const updateActiveState = (activeIndex: number) => {
      indicators.forEach((ind, i) => {
        ind.classList.toggle("is-active", i === activeIndex);
      });
      if (prevBtn) prevBtn.disabled = activeIndex === 0;
      if (nextBtn) nextBtn.disabled = activeIndex === cards.length - 1;
    };

    const scrollToCard = (index: number) => {
      const targetCard = cards[index];
      if (!targetCard) return;
      targetCard.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
    };

    prevBtn?.addEventListener("click", () => {
      const activeIdx = getCurrentActiveIndex();
      if (activeIdx > 0) scrollToCard(activeIdx - 1);
    });

    nextBtn?.addEventListener("click", () => {
      const activeIdx = getCurrentActiveIndex();
      if (activeIdx < cards.length - 1) scrollToCard(activeIdx + 1);
    });

    indicators.forEach((indicator) => {
      indicator.addEventListener("click", () => {
        const targetIdx = Number(indicator.dataset.targetIndex);
        if (!isNaN(targetIdx)) scrollToCard(targetIdx);
      });
    });

    function getCurrentActiveIndex() {
      const trackCenter = track.getBoundingClientRect().left + track.clientWidth / 2;
      let closestIdx = 0;
      let minDistance = Infinity;

      cards.forEach((card, idx) => {
        const cardCenter = card.getBoundingClientRect().left + card.clientWidth / 2;
        const dist = Math.abs(trackCenter - cardCenter);
        if (dist < minDistance) {
          minDistance = dist;
          closestIdx = idx;
        }
      });

      return closestIdx;
    }

    let scrollTimer: ReturnType<typeof setTimeout>;
    track.addEventListener(
      "scroll",
      () => {
        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(() => {
          const idx = getCurrentActiveIndex();
          updateActiveState(idx);
        }, 60);
      },
      { passive: true }
    );

    // ── Arrastrar con mouse para scrollear (touch conserva el swipe nativo) ──
    let isDragging = false;
    let dragMoved = false;
    let dragStartX = 0;
    let dragStartScroll = 0;

    track.addEventListener("pointerdown", (e: PointerEvent) => {
      if (e.pointerType !== "mouse") return;
      isDragging = true;
      dragMoved = false;
      dragStartX = e.clientX;
      dragStartScroll = track.scrollLeft;
      track.classList.add("is-dragging");
      track.setPointerCapture(e.pointerId);
    });

    track.addEventListener("pointermove", (e: PointerEvent) => {
      if (!isDragging) return;
      const delta = e.clientX - dragStartX;
      if (Math.abs(delta) > 4) dragMoved = true;
      track.scrollLeft = dragStartScroll - delta;
    });

    const endDrag = (e: PointerEvent) => {
      if (!isDragging) return;
      isDragging = false;
      track.classList.remove("is-dragging");
      try {
        track.releasePointerCapture(e.pointerId);
      } catch {
        // el pointer ya pudo haber liberado el capture (p. ej. pointercancel)
      }
      if (dragMoved) scrollToCard(getCurrentActiveIndex());
    };

    track.addEventListener("pointerup", endDrag);
    track.addEventListener("pointercancel", endDrag);

    // Arrastrar una card no debe además disparar el link de su CTA
    track.addEventListener(
      "click",
      (e) => {
        if (dragMoved) {
          e.preventDefault();
          e.stopPropagation();
          dragMoved = false;
        }
      },
      true
    );

    updateActiveState(0);
  }

  if (document.readyState === "complete" || document.readyState === "interactive") {
    initPortfolio();
  } else {
    document.addEventListener("DOMContentLoaded", initPortfolio);
  }
  document.addEventListener("astro:page-load", initPortfolio);
</script>
