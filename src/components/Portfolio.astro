---
/**
 * "Ya estamos construyendo eso" — casos de éxito como prueba social visceral.
 * Fuente: vault §5.
 */
import { PORTFOLIO_PROJECTS } from "@/constants/portfolio";
---

<section id="proyectos" class="relative overflow-hidden bg-background py-28 lg:py-36">
  <div class="container mx-auto mb-16 px-4 sm:px-6 lg:mb-20 lg:px-8">
    <div id="portfolio-header" class="max-w-2xl translate-y-6 opacity-0">
      <h2 class="headline-editorial text-4xl text-foreground sm:text-5xl lg:text-6xl">
        Ya estamos<br />construyendo eso
      </h2>
      <p class="mt-6 max-w-md text-sm font-medium leading-relaxed text-muted-foreground sm:text-base">
        Proyectos reales donde la tecnología crea comunidad.
      </p>
    </div>
  </div>

  <div class="flex flex-col">
    {
      PORTFOLIO_PROJECTS.map((project) => (
        <a
          href="#agendar"
          class="js-portfolio-item media-duotone media-duotone-reveal group relative flex h-[70vh] w-full items-end overflow-hidden opacity-0 lg:h-[85vh]"
        >
          <img
            src={project.image}
            alt={project.imageAlt}
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            loading="lazy"
          />

          {/* Caption permanente — esquina inferior izquierda */}
          <div class="pointer-events-none relative z-[2] w-full px-4 pb-10 sm:px-6 lg:px-12 lg:pb-14">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-white/60">
              {project.title}
            </p>
            <p class="mt-3 max-w-md text-sm font-medium leading-relaxed text-white/80 sm:text-base">
              {project.description}
            </p>
          </div>

          {/* Cita del cliente — revelada al hover */}
          <div class="pointer-events-none absolute inset-0 z-[3] flex items-center justify-center bg-black/45 opacity-0 transition-opacity duration-500 ease-out group-hover:opacity-100">
            <p class="max-w-lg translate-y-4 px-6 text-center text-2xl font-bold leading-snug text-white transition-transform duration-500 ease-out group-hover:translate-y-0 sm:text-3xl lg:text-4xl">
              &ldquo;{project.quote}&rdquo;
            </p>
          </div>
        </a>
      ))
    }
  </div>
</section>
