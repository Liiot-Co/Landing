---
import { ArrowRight } from "lucide-astro";
import {
  finalCtaButtonBase,
  finalCtaButtonSizeClasses,
  type FinalCtaButtonSize,
} from "@/constants/finalCtaButton";

interface Props {
  href?: string;
  type?: "button" | "submit" | "reset";
  size?: FinalCtaButtonSize;
  class?: string;
  /** Default: true for all sizes except `compact` */
  showArrow?: boolean;
  target?: string;
  rel?: string;
}

const {
  href,
  type = "button",
  size = "section",
  class: className = "",
  showArrow,
  target,
  rel: relProp,
} = Astro.props;

const rel =
  relProp ?? (target === "_blank" ? "noopener noreferrer" : undefined);

const showArrowResolved = showArrow ?? size !== "compact";

const classes = [finalCtaButtonBase, finalCtaButtonSizeClasses[size], className]
  .filter(Boolean)
  .join(" ");

const innerWrapClass =
  size === "section"
    ? "relative z-20 flex items-center justify-center gap-3"
    : size === "widget" || size === "spotlight"
      ? "relative z-20 flex items-center gap-2"
      : "relative z-20 flex items-center justify-center gap-2";

const arrowSizeClass =
  size === "section" || size === "hero"
    ? "w-5 h-5"
    : size === "form" || size === "widget"
      ? "h-4 w-4"
      : size === "spotlight"
        ? "h-3.5 w-3.5"
        : "";

const textClass =
  size === "section" ? "text-lg" : size === "hero" ? "text-base" : "text-base";

// The HTML for the dark volumetric background and the shine effect
const darkVolumetricEffect = `
  <div class="absolute inset-0 z-0 bg-black"></div>
  
  <div class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_0%_0%,var(--color-primary),transparent_75%)] opacity-90 transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-110"></div>
  
  <div class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_100%_100%,var(--color-accent),transparent_75%)] opacity-90 transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-110"></div>
  
  <div class="absolute inset-0 z-10 -translate-x-[150%] skew-x-[-25deg] bg-[linear-gradient(90deg,transparent,rgba(255,255,255,0.25),transparent)] transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-[150%]" aria-hidden="true"></div>
`;
---

{
  href ? (
    <a href={href} class={classes} target={target} rel={rel}>
      <Fragment set:html={darkVolumetricEffect} />

      <span class={innerWrapClass}>
        <span class={textClass}>
          <slot />
        </span>
        {showArrowResolved && (
          <ArrowRight
            class:list={[
              arrowSizeClass,
              "transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-1.5",
            ]}
          />
        )}
      </span>
    </a>
  ) : (
    <button type={type} class={classes}>
      <Fragment set:html={darkVolumetricEffect} />

      <span class={innerWrapClass}>
        <span class={textClass}>
          <slot />
        </span>
        {showArrowResolved && (
          <ArrowRight
            class:list={[
              arrowSizeClass,
              "transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-1.5",
            ]}
          />
        )}
      </span>
    </button>
  )
}
