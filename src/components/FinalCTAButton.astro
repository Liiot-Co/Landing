---
import { ArrowRight } from "lucide-astro";
import {
  finalCtaButtonBase,
  finalCtaButtonSizeClasses,
  type FinalCtaButtonSize,
} from "@/constants/finalCtaButton";

interface Props {
  href?: string;
  type?: "button" | "submit" | "reset";
  size?: FinalCtaButtonSize;
  class?: string;
  /** Default: true for all sizes except `compact` */
  showArrow?: boolean;
}

const {
  href,
  type = "button",
  size = "section",
  class: className = "",
  showArrow,
} = Astro.props;

const showArrowResolved = showArrow ?? size !== "compact";

const classes = [finalCtaButtonBase, finalCtaButtonSizeClasses[size], className]
  .filter(Boolean)
  .join(" ");

// An internal soft radial glow that slowly reveals itself on hover
const innerGlowClass =
  "absolute inset-0 rounded-[inherit] opacity-0 group-hover:opacity-100 transition-opacity duration-700 ease-out bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.1)_0%,transparent_70%)] pointer-events-none";

const innerWrapClass =
  size === "section"
    ? "relative z-10 flex items-center justify-center gap-3"
    : size === "widget" || size === "spotlight"
      ? "relative z-10 flex items-center"
      : "relative z-10 flex items-center justify-center gap-2";

const arrowClass =
  size === "section" || size === "hero"
    ? "w-6 h-6"
    : size === "form" || size === "widget"
      ? "h-5 w-5"
      : size === "spotlight"
        ? "h-4 w-4"
        : "";

// Added tracking transition for the luxury editorial feel
const textClass =
  (size === "section" || size === "hero" ? "text-lg" : "text-base") +
  " transition-all duration-700 ease-out group-hover:tracking-[0.02em]";
---

{
  href ? (
    <a href={href} class={classes}>
      <span class={innerWrapClass}>
        <span class={textClass}>
          <slot />
        </span>
        {showArrowResolved && (
          <ArrowRight
            class:list={[
              arrowClass,
              size === "widget" || size === "spotlight" ? "ml-2" : "",
              "shrink-0 opacity-80 transition-all duration-500 ease-out group-hover:opacity-100 group-hover:translate-x-1.5",
            ]}
          />
        )}
      </span>
      <span class={innerGlowClass} aria-hidden="true" />
    </a>
  ) : (
    <button type={type} class={classes}>
      <span class={innerWrapClass}>
        <span class={textClass}>
          <slot />
        </span>
        {showArrowResolved && (
          <ArrowRight
            class:list={[
              arrowClass,
              size === "widget" || size === "spotlight" ? "ml-2" : "",
              "shrink-0 opacity-80 transition-all duration-500 ease-out group-hover:opacity-100 group-hover:translate-x-1.5",
            ]}
          />
        )}
      </span>
      <span class={innerGlowClass} aria-hidden="true" />
    </button>
  )
}
