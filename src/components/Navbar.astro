---
import LiiotMark from "@/components/ui/LiiotMarkAnimated.astro";
import { LIIOT_CALENDLY_URL } from "@/constants/contact";

interface NavLink {
  name: string;
  path: string;
}

const navLinks: NavLink[] = [
  { name: "Por qué existimos", path: "#por-que-existimos" },
  { name: "Cómo trabajamos", path: "#como-trabajamos" },
  { name: "Proyectos", path: "#proyectos" },
  { name: "Equipo", path: "#equipo" },
  { name: "Agendar", path: "#agendar" },
];
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 flex justify-center pointer-events-none px-3 pt-3 transition-all duration-300 sm:px-6 sm:pt-4"
>
  <nav
    id="site-nav"
    class="nav-pill pointer-events-auto flex w-full max-w-7xl items-center justify-between px-4 py-3.5 transition-all duration-300 sm:px-6 sm:py-4"
    role="navigation"
    aria-label="Navegación principal"
  >
    {/* Brand */}
    <a
      href="#hero"
      class="group flex items-center gap-2.5 transition-transform duration-200 hover:scale-105"
      aria-label="Liiot — Inicio"
    >
      <LiiotMark class="size-7 sm:size-8" color="violet" />
      <span class="text-lg font-bold tracking-tight text-white">Liiot</span>
    </a>

    {/* Hamburger Toggle */}
    <button
      id="nav-toggle"
      class="nav-toggle-btn relative flex size-10 items-center justify-center rounded-full transition-all duration-200 hover:bg-white/10 active:scale-95"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="nav-drawer"
    >
      <div class="flex flex-col items-center justify-center gap-[6px]">
        <span
          id="nav-line-1"
          class="block h-[1.5px] w-5 origin-center bg-white transition-transform duration-300 ease-out"
        ></span>
        <span
          id="nav-line-2"
          class="block h-[1.5px] w-5 origin-center bg-white transition-transform duration-300 ease-out"
        ></span>
      </div>
    </button>
  </nav>
</header>

{/* Overlay drawer — menú pantalla completa */}
<div
  id="nav-drawer"
  class="fixed inset-0 z-40 flex translate-y-[-8px] flex-col justify-center bg-background opacity-0 pointer-events-none transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]"
  role="menu"
  aria-hidden="true"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <ul class="flex flex-col gap-2">
      {
        navLinks.map((link, i) => (
          <li>
            <a
              href={link.path}
              data-nav-item
              role="menuitem"
              class="drawer-link block py-2 text-[12vw] font-bold leading-[1.05] tracking-tight text-foreground transition-colors duration-300 hover:text-accent sm:text-6xl lg:text-7xl"
              style={`transition-delay:${i * 40}ms`}
            >
              {link.name}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={LIIOT_CALENDLY_URL}
      target="_blank"
      rel="noopener noreferrer"
      data-nav-item
      role="menuitem"
      class="mt-12 inline-flex items-center gap-2 text-sm font-bold uppercase tracking-[0.2em] text-accent"
    >
      Agendar consultoría
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</div>

<style>
  .nav-pill {
    border-radius: 9999px;
    border: 1px solid transparent;
    background: transparent;
  }

  /* ════════════════════════════════════════════════════════════════════
     ESTADO GLASSMORPHIC PILL AL HACER SCROLL (DEGRADE SUTIL LIIOT DARK)
     ════════════════════════════════════════════════════════════════════ */
  .nav-pill.is-scrolled {
    max-width: 36rem;
    padding: 0.5rem 1.25rem;
    background: linear-gradient(
      135deg,
      rgba(90, 34, 139, 0.42) 0%,
      rgba(15, 10, 26, 0.86) 48%,
      rgba(255, 106, 51, 0.24) 100%
    );
    background-color: rgba(7, 4, 15, 0.8);
    backdrop-filter: blur(20px) saturate(190%);
    -webkit-backdrop-filter: blur(20px) saturate(190%);
    border-color: rgba(255, 255, 255, 0.14);
    box-shadow:
      0 16px 36px -10px rgba(0, 0, 0, 0.7),
      0 0 24px -6px rgba(90, 34, 139, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);
  }

  @media (min-width: 640px) {
    .nav-pill.is-scrolled {
      max-width: 40rem;
      padding: 0.625rem 1.75rem;
    }
  }

  @media (min-width: 1024px) {
    .nav-pill.is-scrolled {
      max-width: 44rem;
      padding: 0.625rem 2rem;
    }
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle")!;
  const drawer = document.getElementById("nav-drawer")!;
  const line1 = document.getElementById("nav-line-1")!;
  const line2 = document.getElementById("nav-line-2")!;
  const navItems = drawer.querySelectorAll<HTMLElement>("[data-nav-item]");

  let open = false;

  function setDrawer(next: boolean) {
    open = next;
    toggle.setAttribute("aria-expanded", String(open));
    drawer.setAttribute("aria-hidden", String(!open));
    drawer.classList.toggle("opacity-0", !open);
    drawer.classList.toggle("pointer-events-none", !open);
    drawer.classList.toggle("translate-y-[-8px]", !open);
    line1.style.transform = open ? "translateY(3px) rotate(45deg)" : "none";
    line2.style.transform = open ? "translateY(-3px) rotate(-45deg)" : "none";
    document.body.style.overflow = open ? "hidden" : "";
  }

  toggle.addEventListener("click", () => setDrawer(!open));
  navItems.forEach((el) => el.addEventListener("click", () => setDrawer(false)));

  // Glassmorphic pill al hacer scroll
  function initNavScroll() {
    const nav = document.getElementById("site-nav");
    if (!nav) return;

    const onScroll = () => {
      const isScrolled = window.scrollY > 20;
      nav.classList.toggle("is-scrolled", isScrolled);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }

  if (document.readyState === "complete" || document.readyState === "interactive") {
    initNavScroll();
  } else {
    document.addEventListener("DOMContentLoaded", initNavScroll);
  }
  document.addEventListener("astro:page-load", initNavScroll);
</script>
