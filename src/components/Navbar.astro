---
import { Menu, X } from "lucide-astro";
import { cn } from "@/lib/utils";

interface NavLink {
  name: string;
  path: string;
}

const navLinks: NavLink[] = [
  { name: "Inicio", path: "#hero" },
  { name: "Problema", path: "#pain-points" },
  { name: "Producto", path: "#features" },
  { name: "Empresa", path: "#company" },
  { name: "Demo", path: "#cta" },
];
---

<nav
  id="site-nav"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent"
  role="navigation"
  aria-label="Navegación principal"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      {/* Brand */}
      <a
        href="/"
        class="flex items-center space-x-2 group"
        aria-label="Liiot — Inicio"
      >
        <div
          class="w-8 h-8 rounded-lg bg-primary flex items-center justify-center transition-transform group-hover:scale-110"
        >
          <span class="text-primary-foreground font-bold text-sm tracking-tight"
            >aT</span
          >
        </div>
        <div class="flex flex-col leading-none">
          <span class="text-lg font-bold text-foreground">Liiot</span>
          <span
            class="text-xs text-accent font-medium tracking-widest uppercase"
            >Hedul</span
          >
        </div>
      </a>

      {/* Desktop links */}
      <div class="hidden md:flex items-center gap-8">
        {
          navLinks.map((link) => (
            <a
              href={link.path}
              class={cn(
                "text-sm font-medium transition-colors relative py-2 text-muted-foreground hover:text-foreground",
              )}
            >
              {link.name}
            </a>
          ))
        }

        <a
          href="#cta"
          class="inline-flex items-center gap-2 rounded-xl bg-linear-to-r from-primary via-accent/90 to-primary bg-size-[165%_165%] bg-position-[18%_50%] px-5 py-2.5 text-sm font-semibold text-primary-foreground ring-1 ring-white/15 transition-all duration-300 ease-out hover:bg-position-[85%_50%] hover:brightness-110 hover:ring-white/25"
        >
          Solicitar demo
        </a>
      </div>

      {/* Mobile toggle */}
      <button
        id="nav-toggle"
        class="md:hidden p-2 text-foreground"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="nav-drawer"
      >
        <Menu id="nav-icon-open" class="w-6 h-6" aria-hidden="true" />
        <X id="nav-icon-close" class="w-6 h-6 hidden" aria-hidden="true" />
      </button>
    </div>

    {/* Mobile drawer */}
    <div
      id="nav-drawer"
      class="md:hidden py-4 border-t border-border hidden"
      role="menu"
    >
      <div class="flex flex-col space-y-1">
        {
          navLinks.map((link) => (
            <a
              href={link.path}
              class={cn(
                "text-sm font-medium transition-colors px-2 py-3 rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted/50",
              )}
              data-nav-item
              role="menuitem"
            >
              {link.name}
            </a>
          ))
        }
        <a
          href="#cta"
          class="mt-2 inline-flex items-center justify-center rounded-xl bg-linear-to-r from-primary via-accent/90 to-primary bg-size-[165%_165%] bg-position-[18%_50%] px-5 py-3 text-sm font-semibold text-primary-foreground ring-1 ring-white/15 transition-all duration-300 ease-out hover:bg-position-[85%_50%] hover:brightness-110 hover:ring-white/25"
          data-nav-item
          role="menuitem"
        >
          Solicitar demo
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  // ── Selectors ──────────────────────────────────────────────────────────────
  const nav = document.getElementById("site-nav")!;
  const toggle = document.getElementById("nav-toggle")!;
  const drawer = document.getElementById("nav-drawer")!;
  const iconOpen = document.getElementById("nav-icon-open")!;
  const iconClose = document.getElementById("nav-icon-close")!;
  const navItems = drawer.querySelectorAll("[data-nav-item]");

  // ── Config ─────────────────────────────────────────────────────────────────
  const GLASS = [
    "bg-background/85",
    "backdrop-blur-xl",
    "border-b",
    "border-border/60",
    "shadow-sm",
  ];
  const SCROLL_THRESHOLD = 20;

  // ── State ──────────────────────────────────────────────────────────────────
  let scrolled = false;
  let drawerOpen = false;

  // ── Scroll → glass effect ──────────────────────────────────────────────────
  function onScroll() {
    const isScrolled = window.scrollY > SCROLL_THRESHOLD;
    if (isScrolled === scrolled) return;
    scrolled = isScrolled;
    nav.classList.toggle("bg-transparent", !scrolled);
    GLASS.forEach((c) => nav.classList.toggle(c, scrolled));
  }

  // ── Drawer toggle ──────────────────────────────────────────────────────────
  function setDrawer(open: boolean) {
    drawerOpen = open;
    toggle.setAttribute("aria-expanded", String(open));
    drawer.classList.toggle("hidden", !open);
    iconOpen.classList.toggle("hidden", open);
    iconClose.classList.toggle("hidden", !open);
  }

  // ── Listeners ──────────────────────────────────────────────────────────────
  window.addEventListener("scroll", onScroll, { passive: true });
  toggle.addEventListener("click", () => setDrawer(!drawerOpen));
  navItems.forEach((el) =>
    el.addEventListener("click", () => setDrawer(false)),
  );

  onScroll(); // init
</script>
