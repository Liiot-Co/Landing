---
/**
 * SEO.astro — Gestión integral de metadatos, OpenGraph, Twitter Cards y JSON-LD (Schema.org).
 */
import {
  LIIOT_EMAIL,
  LIIOT_CALENDLY_URL,
  LIIOT_LINKEDIN_URL,
  LIIOT_INSTAGRAM_URL,
} from "@/constants/contact";
import { TEAM_MEMBERS } from "@/constants/team";
import { IMAGES } from "@/constants/images";
import { t } from "@/i18n";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: string;
  noindex?: boolean;
}

const {
  title = t.seo.defaultTitle,
  description = t.seo.defaultDescription,
  canonical,
  image = IMAGES.seo.ogImage,
  type = "website",
  noindex = false,
} = Astro.props;

// Normalización de URLs absolutas
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://www.liiot.app";
const canonicalURL = canonical || new URL(Astro.url.pathname, siteUrl).toString();
const ogImageURL = image.startsWith("http") ? image : new URL(image, siteUrl).toString();

// Slug estable derivado del propio perfil de LinkedIn (no inventa datos nuevos).
// Se mantiene el path tal cual (ya percent-encoded) para que el fragmento sea un URI válido en ASCII.
const linkedinSlug = (url: string) =>
  new URL(url).pathname.replace(/^\/in\//, "").replace(/\/$/, "");

// Un nodo Person por persona, con @id estable, para referenciarlo desde founder/employee
// en vez de duplicar el objeto completo dos veces por persona.
const personNodes = TEAM_MEMBERS.map((member) => ({
  "@type": "Person",
  "@id": `${siteUrl}/#person-${linkedinSlug(member.linkedin)}`,
  "name": member.name,
  "jobTitle": member.role,
  "url": member.linkedin,
  "sameAs": [member.linkedin],
}));

// Schema.org JSON-LD estructurado bajo especificación @graph
const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "Liiot",
      "legalName": "Liiot",
      "url": `${siteUrl}/`,
      "logo": `${siteUrl}${IMAGES.seo.favicon}`,
      "image": ogImageURL,
      "description": t.seo.schema.organizationDescription,
      "email": LIIOT_EMAIL,
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "CO",
      },
      "sameAs": [
        LIIOT_LINKEDIN_URL,
        LIIOT_INSTAGRAM_URL,
      ],
      "founder": personNodes.map((person) => ({ "@id": person["@id"] })),
      "employee": personNodes.map((person) => ({ "@id": person["@id"] })),
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "contactType": "sales and technical consulting",
          "email": LIIOT_EMAIL,
          "url": LIIOT_CALENDLY_URL,
          "availableLanguage": ["Spanish", "English"],
        },
      ],
      "knowsAbout": [
        "Desarrollo de Software a Medida",
        "Ingeniería de Software",
        "Automatización de Procesos Empresariales",
        "Sistemas SG-SST Digitales",
        "Plataformas Web y SaaS",
        "Arquitectura de Software Cloud",
      ],
    },
    ...personNodes,
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": `${siteUrl}/`,
      "name": "Liiot",
      "description": t.seo.schema.websiteDescription,
      "publisher": {
        "@id": `${siteUrl}/#organization`,
      },
      "inLanguage": "es",
    },
    {
      "@type": "WebPage",
      "@id": `${siteUrl}/#webpage`,
      "url": canonicalURL,
      "name": title,
      "description": description,
      "isPartOf": {
        "@id": `${siteUrl}/#website`,
      },
      "about": {
        "@id": `${siteUrl}/#organization`,
      },
      "inLanguage": "es",
    },
    {
      "@type": "Service",
      "@id": `${siteUrl}/#service-custom-software`,
      "name": t.seo.schema.services.customSoftware.name,
      "serviceType": "Custom Software Development",
      "provider": {
        "@id": `${siteUrl}/#organization`,
      },
      "description": t.seo.schema.services.customSoftware.description,
      "areaServed": "Worldwide",
    },
    {
      "@type": "Service",
      "@id": `${siteUrl}/#service-digital-products`,
      "name": t.seo.schema.services.digitalProducts.name,
      "serviceType": "Digital Product Engineering",
      "provider": {
        "@id": `${siteUrl}/#organization`,
      },
      "description": t.seo.schema.services.digitalProducts.description,
      "areaServed": "Worldwide",
    },
    {
      "@type": "Service",
      "@id": `${siteUrl}/#service-consulting`,
      "name": t.seo.schema.services.consulting.name,
      "serviceType": "Technology Consulting",
      "provider": {
        "@id": `${siteUrl}/#organization`,
      },
      "description": t.seo.schema.services.consulting.description,
      "areaServed": "Worldwide",
    },
  ],
};
---

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Metadatos Básicos -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Liiot" />
<meta name="application-name" content="Liiot" />
<meta
  name="robots"
  content={noindex
    ? "noindex, nofollow"
    : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
/>
<meta name="theme-color" content="#0B0710" />

<!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Liiot" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:alt" content={t.seo.ogImageAlt} />
<meta property="og:locale" content="es_CO" />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={t.seo.ogImageAlt} />

<!-- Descubrimiento para Motores y LLMs -->
<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Context (llms.txt)" />
<link rel="alternate" type="text/plain" href="/llm.txt" title="LLM Context (llm.txt)" />

<!-- Schema.org JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
