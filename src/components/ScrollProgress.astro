---
/**
 * Thin scroll-progress bar fixed at the very top of the viewport.
 * Gradient from primary → accent — mirrors the brand text-gradient.
 */
---

<div
  id="scroll-progress"
  class="fixed top-0 left-0 h-[3px] z-[60] pointer-events-none origin-left"
  style="transform: scaleX(0); background: linear-gradient(90deg, var(--primary) 0%, var(--accent) 100%);"
  aria-hidden="true"
></div>

<script>
  const bar = document.getElementById("scroll-progress")!;

  function updateProgress() {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = docHeight > 0 ? Math.min(scrollTop / docHeight, 1) : 0;
    bar.style.transform = `scaleX(${progress})`;
    bar.style.width = "100%";
  }

  window.addEventListener("scroll", updateProgress, { passive: true });
  updateProgress();
</script>
